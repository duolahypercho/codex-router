{
  "version": 1,
  "providers": [
    {
      "id": "unorouter",
      "displayName": "UnoRouter",
      "kind": "openai-compatible",
      "ownedBy": "unorouter",
      "baseUrl": "https://api.unorouter.com/v1",
      "baseUrlEnv": "UNOROUTER_API_BASE_URL",
      "credential": {
        "environment": [
          "UNOROUTER_API_KEY"
        ],
        "file": "unorouter-api-key.secret",
        "legacyFiles": [],
        "keychainServices": [
          "codex-router-unorouter"
        ],
        "prompt": "UnoRouter API key"
      }
    }
  ]
}
