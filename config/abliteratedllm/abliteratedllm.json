{
  "version": 1,
  "providers": [
    {
      "id": "abliteratedllm",
      "displayName": "AbliteratedLLM",
      "kind": "openai-compatible",
      "ownedBy": "abliteratedllm",
      "baseUrl": "https://api.abliteratedllm.dev/v1",
      "baseUrlEnv": "ABLITERATEDLLM_API_BASE_URL",
      "credential": {
        "environment": [
          "ABLITERATEDLLM_API_KEY"
        ],
        "file": "abliteratedllm-api-key.secret",
        "legacyFiles": [],
        "keychainServices": [
          "codex-router-abliteratedllm"
        ],
        "prompt": "AbliteratedLLM API key"
      }
    }
  ]
}
