{
  "version": 1,
  "providers": [
    {
      "id": "runcrate",
      "displayName": "Runcrate",
      "kind": "openai-compatible",
      "ownedBy": "runcrate",
      "baseUrl": "https://api.runcrate.ai/v1",
      "baseUrlEnv": "RUNCRATE_API_BASE_URL",
      "credential": {
        "environment": [
          "RUNCRATE_API_KEY"
        ],
        "file": "runcrate-api-key.secret",
        "legacyFiles": [],
        "keychainServices": [
          "codex-router-runcrate"
        ],
        "prompt": "Runcrate API key"
      }
    }
  ]
}
