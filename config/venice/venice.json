{
  "version": 1,
  "providers": [
    {
      "id": "venice",
      "displayName": "Venice",
      "kind": "openai-compatible",
      "ownedBy": "venice",
      "baseUrl": "https://api.venice.ai/api/v1",
      "baseUrlEnv": "VENICE_API_BASE_URL",
      "credential": {
        "environment": [
          "VENICE_API_KEY"
        ],
        "file": "venice-api-key.secret",
        "legacyFiles": [],
        "keychainServices": [
          "codex-router-venice"
        ],
        "prompt": "Venice API key"
      }
    }
  ]
}
