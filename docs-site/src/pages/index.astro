---
import "@fontsource-variable/manrope";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

const githubUrl = "https://github.com/duolahypercho/codex-router";
const installCommand = `brew tap duolahypercho/codex-router https://github.com/duolahypercho/codex-router
brew install codex-router
codex-router setup --guided`;

const providers = [
  { name: "Anthropic", logo: "/providers/anthropic.png" },
  { name: "Kimi", logo: "/providers/kimi.png" },
  { name: "DeepSeek", logo: "/providers/deepseek.png" },
  { name: "xAI", logo: "/providers/xai.png" },
  { name: "OpenRouter", logo: "/providers/openrouter.png" },
  { name: "Z.ai", logo: "/providers/zai.svg" },
];

const productPrinciples = [
  { title: "Keep the native client", body: "Routed models appear in the picker and workflow your coding client already owns." },
  { title: "Share one local plane", body: "Every installed client uses one background service, catalog, and credential boundary." },
  { title: "Bring your provider access", body: "Use supported APIs, subscriptions, OAuth sessions, and local model runtimes." },
  { title: "See what the router does", body: "Inspect health, quotas, request traffic, model speed, and routing state in one app." },
];

const clients = [
  { name: "Codex", body: "External routes live beside native GPT models in the standard model picker." },
  { name: "DeepSeek Harness", body: "One Responses route publishes the shared catalog without taking over the harness settings." },
  { name: "Gemini CLI", body: "A Gemini edge translates the request, then re-enters the same routed Responses path." },
];

const faqs = [
  { question: "What is Codex Router?", answer: "Codex Router is an open local routing plane that connects supported AI coding clients to external model providers through one managed service." },
  { question: "Does it replace Codex or another coding client?", answer: "No. It preserves each client's native interface and publishes routed models into the client you already use." },
  { question: "Which clients share the router today?", answer: "The supported targets are Codex, DeepSeek Harness, and Gemini CLI. Each client keeps its own settings and sessions." },
  { question: "Where do provider credentials live?", answer: "Credentials stay in the router's private local store. Client integrations receive a scoped local caller capability, not your upstream provider secret." },
  { question: "Is this an OpenRouter for tools and harnesses?", answer: "Models and supported client routing ship today. The architecture can grow into a broader layer for harnesses and tools, but the tools surface is not presented as finished." },
  { question: "Is it open source?", answer: "Yes. The routing plane, installers, client adapters, Control Center, tests, and documentation are available in the public repository under the MIT license." },
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Codex Router",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Linux, Windows",
  description: "An open local model router for Codex, DeepSeek Harness, and Gemini CLI.",
  license: "https://opensource.org/license/mit",
  sourceCode: githubUrl,
};

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL("/app/control-center-models.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f3f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111419" media="(prefers-color-scheme: dark)" />
    <meta name="description" content="A local model router for Codex, DeepSeek Harness, and Gemini CLI. Bring external providers into the coding clients you already use." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content="Codex Router | A local model router for AI coding clients" />
    <meta property="og:description" content="One local control plane for external models across Codex, DeepSeek Harness, and Gemini CLI." />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/router-mark.svg" type="image/svg+xml" />
    <title>Codex Router | A local model router for AI coding clients</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-nav">
      <a class="brand" href="#top" aria-label="Codex Router home">
        <img src="/router-mark.svg" alt="" width="32" height="32" />
        <span>CODEX ROUTER</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#product">Product</a>
        <a href="#control-center">Control Center</a>
        <a href="#architecture">Architecture</a>
        <a href="#install">Install</a>
      </nav>
      <a class="nav-cta" href={githubUrl}>GitHub</a>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-copy" data-reveal>
          <p class="hero-definition">A local model router for Codex, DeepSeek Harness, and Gemini CLI.</p>
          <h1 id="hero-title">One router.<br /><span>Your models.</span></h1>
          <p class="hero-summary">Use external providers without replacing the client, workflow, or account setup you already trust.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#install">Install</a>
            <a class="button button-secondary" href="#control-center">See the app</a>
          </div>
        </div>

        <figure class="hero-product" data-reveal data-delay="1">
          <img src="/app/control-center-models.png" alt="Codex Router Control Center showing provider connections and routed models" width="1440" height="900" loading="eager" fetchpriority="high" />
          <figcaption>Production Control Center UI with local demo data.</figcaption>
        </figure>
      </section>

      <section class="provider-rail" aria-labelledby="provider-heading">
        <p id="provider-heading">Bring the model access you already have.</p>
        <div class="provider-list">
          {providers.map((provider) => (
            <div class="provider">
              <img src={provider.logo} alt="" width="28" height="28" loading="lazy" />
              <span>{provider.name}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="product section-shell" id="product" aria-labelledby="product-title">
        <div class="section-intro" data-reveal>
          <h2 id="product-title">Keep the client. Change the model.</h2>
          <p>Codex Router publishes one curated model catalog into every supported client and manages the shared route behind it.</p>
        </div>
        <div class="principle-grid" data-reveal>
          {productPrinciples.map((principle) => (
            <article>
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="control-center section-shell" id="control-center" aria-labelledby="control-center-title">
        <div class="section-intro" data-reveal>
          <h2 id="control-center-title">See the router at work.</h2>
          <p>The desktop app makes routing state, model selection, quotas, and measured traffic visible without exposing private credentials.</p>
        </div>

        <div class="app-gallery">
          <figure class="app-shot app-shot-dashboard" data-reveal>
            <img src="/app/control-center-dashboard.png" alt="Control Center Dashboard with service health, router state, and traffic overview" width="1440" height="900" loading="lazy" />
            <figcaption><strong>Dashboard</strong><span>Health and traffic at a glance</span></figcaption>
          </figure>
          <figure class="app-shot app-shot-models" data-reveal>
            <img src="/app/control-center-models.png" alt="Control Center Models page with provider connections and model visibility controls" width="1440" height="900" loading="lazy" />
            <figcaption><strong>Models</strong><span>One catalog across provider routes</span></figcaption>
          </figure>
          <figure class="app-shot app-shot-usage" data-reveal>
            <img src="/app/control-center-usage.png" alt="Control Center Usage page with token totals and daily router traffic" width="1440" height="900" loading="lazy" />
            <figcaption><strong>Usage</strong><span>Provider limits and router traffic stay separate</span></figcaption>
          </figure>
        </div>
        <p class="demo-note">Screens use the production renderer with the repository's sanitized demo fixture.</p>
      </section>

      <section class="clients section-shell" id="clients" aria-labelledby="clients-title">
        <div class="section-intro" data-reveal>
          <h2 id="clients-title">One catalog, three native workflows.</h2>
          <p>Each integration respects the protocol and configuration model of the client it serves.</p>
        </div>
        <div class="client-list" data-reveal>
          {clients.map((client) => (
            <article>
              <h3>{client.name}</h3>
              <p>{client.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="architecture section-shell" id="architecture" aria-labelledby="architecture-title">
        <div class="architecture-copy" data-reveal>
          <h2 id="architecture-title">One plane, shared by every client.</h2>
          <p>One background service owns routing policy, credentials, catalog publication, failover, and usage accounting.</p>
        </div>

        <figure class="route-diagram" data-reveal data-delay="1">
          <div class="route-column route-inputs">
            <span>Clients</span>
            <strong>Codex</strong>
            <strong>DeepSeek Harness</strong>
            <strong>Gemini CLI</strong>
          </div>
          <div class="route-core">
            <img src="/router-mark.svg" alt="" width="58" height="58" loading="lazy" />
            <strong>Codex Router</strong>
            <span>Local control plane</span>
          </div>
          <div class="route-column route-outputs">
            <span>Providers</span>
            <strong>API and OAuth</strong>
            <strong>Subscriptions</strong>
            <strong>Local models</strong>
          </div>
          <figcaption>Client settings stay separate. Model routes and credentials are shared.</figcaption>
        </figure>

        <dl class="architecture-facts" data-reveal>
          <div><dt>Credential boundary</dt><dd>Upstream secrets never become client configuration.</dd></div>
          <div><dt>Catalog policy</dt><dd>Only selected, credentialed, and compatible routes are published.</dd></div>
          <div><dt>Single request path</dt><dd>Retries, failover, accounting, and tool handling stay consistent.</dd></div>
          <div><dt>Client ownership</dt><dd>Sessions, defaults, and unrelated settings remain with each client.</dd></div>
        </dl>
      </section>

      <section class="future section-shell" aria-labelledby="future-title">
        <div class="future-copy" data-reveal>
          <h2 id="future-title">A path beyond model routing.</h2>
          <p>The shared local plane can grow into an open routing layer for models, harnesses, and tools without overstating what ships today.</p>
          <div class="future-states" aria-label="Product surface status">
            <div><span>Today</span><strong>Models</strong></div>
            <div><span>Today</span><strong>Harnesses</strong></div>
            <div><span>Next</span><strong>Tools</strong></div>
          </div>
        </div>
        <figure class="future-visual" data-reveal data-delay="1">
          <img src="/campaign/05-experimental-editorial.png" alt="A chrome routing manifold beside an oversized blue Router wordmark" width="1664" height="936" loading="lazy" />
        </figure>
      </section>

      <section class="install section-shell" id="install" aria-labelledby="install-title">
        <div class="install-copy" data-reveal>
          <h2 id="install-title">Install the local plane.</h2>
          <p>Homebrew installs the router and its locked runtime. Guided setup connects providers without putting secrets in shell history.</p>
          <a class="text-link" href={`${githubUrl}#install`}>View all installation options</a>
        </div>
        <div class="command-block" data-reveal data-delay="1">
          <div class="command-header">
            <span>macOS and Linux</span>
            <button class="copy-button" type="button" data-copy-command>Copy</button>
          </div>
          <pre><code data-install-command>{installCommand}</code></pre>
          <p class="copy-status" role="status" aria-live="polite" data-copy-status></p>
        </div>
      </section>

      <section class="faq section-shell" aria-labelledby="faq-title">
        <div class="section-intro" data-reveal>
          <h2 id="faq-title">Questions, answered plainly.</h2>
        </div>
        <div class="faq-list" data-reveal>
          {faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="open-source section-shell" aria-labelledby="source-title">
        <div data-reveal>
          <h2 id="source-title">Open source by design.</h2>
          <p>Inspect the route, extend the integration, or build the next surface on top of the same local plane.</p>
        </div>
        <a class="button button-primary" href={githubUrl}>View on GitHub</a>
      </section>
    </main>

    <footer>
      <a class="brand" href="#top" aria-label="Codex Router home">
        <img src="/router-mark.svg" alt="" width="32" height="32" loading="lazy" />
        <span>CODEX ROUTER</span>
      </a>
      <p>Independent community project. Not affiliated with OpenAI or any provider.</p>
      <a href={githubUrl}>MIT licensed</a>
    </footer>

    <script is:inline>
      const revealItems = document.querySelectorAll("[data-reveal]");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduceMotion) {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.12 });
        revealItems.forEach((item) => observer.observe(item));
      }

      const copyButton = document.querySelector("[data-copy-command]");
      const command = document.querySelector("[data-install-command]");
      const copyStatus = document.querySelector("[data-copy-status]");
      copyButton?.addEventListener("click", async () => {
        if (!(command instanceof HTMLElement) || !(copyButton instanceof HTMLButtonElement)) return;
        try {
          await navigator.clipboard.writeText(command.innerText);
          copyButton.textContent = "Copied";
          if (copyStatus) copyStatus.textContent = "Install commands copied.";
          window.setTimeout(() => {
            copyButton.textContent = "Copy";
            if (copyStatus) copyStatus.textContent = "";
          }, 1800);
        } catch {
          copyButton.textContent = "Select command";
          if (copyStatus) copyStatus.textContent = "Copy failed. Select the command manually.";
        }
      });
    </script>
  </body>
</html>
