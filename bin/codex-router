#!/bin/sh
set -eu

# Single entry point for the maintenance commands that already live beside it in
# `bin/`. A checkout can call those directly, but a packaged install cannot: a
# package manager puts one name on PATH, not a directory of them, so `brew
# install` exposes this dispatcher and `codex-router setup` reaches the same
# script `./bin/setup` does.
#
# Every sibling walks the same symlink chain before locating its root, and the
# dispatcher must as well: a checkout user may link it onto PATH by hand, and
# `bin_dir` is where the sibling it execs actually lives. The root is resolved
# physically for the same reason as in the siblings, and a packaged install is
# the case that needs it most: the formula's wrapper execs this script at
# `<prefix>/opt/<formula>/libexec/bin/codex-router`, where the file is not a
# link but `opt/<formula>` is one into the versioned keg, so the walk is a
# no-op and only the physical root matches the path node realpaths a module to
# before treating it as the main module.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname -- "$self")/$link ;;
  esac
done
bin_dir=$(CDPATH= cd -P -- "$(dirname -- "$self")" && pwd -P)
repo_dir=$(CDPATH= cd -P -- "$bin_dir/.." && pwd -P)

usage() {
  cat <<'EOF'
Usage: codex-router <command> [options]

Setup and status
  setup             Configure Codex integration and provider credentials
  doctor            Diagnose the installation and report what is wrong
  status            Show the background service and routing state
  start             Run the router in the foreground (debugging)

Providers and models
  providers         List providers and their authentication state
  provider-key      Store or clear a provider API key
  key-pool          Inspect or manage credential IDs in an API-key pool
  search-sidecar    Manage explicit per-model Perplexity Search bindings
  chatgpt-session   Authorize or revoke shared native GPT access
  curate-models     Add, edit, or remove locally curated models
  discover-models   Probe a provider for the models it exposes
  refresh-catalog   Rebuild the merged model catalog
  test-model        Send one small billed request to a model
  local-mlx         Install or inspect the supported local MLX model

Maintenance
  update            Update the installation (Git checkouts only)
  rollback          Restore the previously installed revision
  enable            Re-apply the Codex configuration
  disable           Remove the Codex configuration, keeping the install
  uninstall         Remove the Codex integration and background service
  support-bundle    Collect logs and configuration for a bug report

Run `codex-router <command> --help` where a command supports it.
EOF
}

command=${1:-}
case $command in
  "" | -h | --help | help)
    usage
    exit 0
    ;;
  -V | --version | version)
    exec node -p "require('$repo_dir/package.json').version"
    ;;
esac
shift

# A command is a name, never a path: rejecting separators and dot-prefixes keeps
# `codex-router ../something` from reaching outside `bin/`.
case $command in
  *[/\\]* | .*)
    echo "codex-router: unknown command: $command" >&2
    exit 2
    ;;
esac

# `install` is deliberately absent. It is the installer that `install.sh` and
# `update` drive, it rewrites the very directory it lives in, and a packaged
# install has no writable one to rewrite.
if [ "$command" = install ] || [ ! -x "$bin_dir/$command" ]; then
  echo "codex-router: unknown command: $command" >&2
  echo "Run 'codex-router help' for the available commands." >&2
  exit 2
fi

exec "$bin_dir/$command" "$@"
