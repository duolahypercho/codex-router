#!/bin/sh
# Regenerate requirements/python.txt, the hash-verified transitive closure of
# PYTHON_REQUIREMENTS in src/install-plan.mjs.
#
# The compile input is written from PYTHON_REQUIREMENTS rather than edited by
# hand, so the direct pins have exactly one author. Run this after changing a
# pin, then commit both requirements/ files together; test/python-lock.test.mjs
# fails the suite while they disagree.
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"

if ! command -v uv >/dev/null 2>&1; then
  echo "uv is required to regenerate the lock: https://docs.astral.sh/uv/" >&2
  exit 1
fi

{
  echo "# Direct Python requirements for the LiteLLM gateway."
  echo "#"
  echo "# Generated by bin/lock-python from PYTHON_REQUIREMENTS in"
  echo "# src/install-plan.mjs. Do not edit by hand: change the pin there and"
  echo "# re-run bin/lock-python, which also recompiles requirements/python.txt."
  node src/install-plan.mjs requirements
} > requirements/python.in

# --universal is what makes one file serve macOS, Linux, and Windows; without
# it the output silently resolves only for the machine that generated it.
# --python-version 3.10 is the floor both installers enforce.
uv pip compile \
  --universal \
  --generate-hashes \
  --python-version 3.10 \
  --output-file requirements/python.txt \
  requirements/python.in

echo "Regenerated requirements/python.in and requirements/python.txt."
echo "Verify with: npm test"
