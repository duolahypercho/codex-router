#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"
target=${MODEL_ROUTER_TARGET:-codex}
case "$target" in
  codex|dsh|gemini|cursor|claude) ;;
  *) echo "MODEL_ROUTER_TARGET must be codex, dsh, gemini, cursor, or claude." >&2; exit 2 ;;
esac
CODEX_ROUTER_NODE_BIN=${CODEX_ROUTER_NODE_BIN:-$(command -v node)}
export CODEX_ROUTER_NODE_BIN
adopt_native_catalog=false
cursor_public_url=
cursor_tunnel_hostname=
while [ "$#" -gt 0 ]; do
  argument=$1
  case "$argument" in
    --adopt-native-catalog) adopt_native_catalog=true; shift ;;
    --public-url) [ "$#" -ge 2 ] || { echo "--public-url requires an HTTPS origin." >&2; exit 2; }; cursor_public_url=$2; shift 2 ;;
    --hostname) [ "$#" -ge 2 ] || { echo "--hostname requires a public hostname." >&2; exit 2; }; cursor_tunnel_hostname=$2; shift 2 ;;
    *) echo "Usage: $0 [--adopt-native-catalog] [--hostname PUBLIC_HOSTNAME|--public-url HTTPS_ORIGIN]" >&2; exit 2 ;;
  esac
done
if [ -n "$cursor_public_url" ]; then
  [ "$target" = cursor ] || { echo "--public-url applies to the Cursor target only." >&2; exit 2; }
  MODEL_ROUTER_CURSOR_PUBLIC_BASE_URL=$cursor_public_url
  export MODEL_ROUTER_CURSOR_PUBLIC_BASE_URL
fi
if [ -n "$cursor_tunnel_hostname" ]; then
  [ "$target" = cursor ] || { echo "--hostname applies to the Cursor target only." >&2; exit 2; }
  [ -z "$cursor_public_url" ] || { echo "Use either --hostname or --public-url, not both." >&2; exit 2; }
  MODEL_ROUTER_CURSOR_TUNNEL_HOSTNAME=$cursor_tunnel_hostname
  export MODEL_ROUTER_CURSOR_TUNNEL_HOSTNAME
fi
if [ "$target" != codex ] && [ "$adopt_native_catalog" = true ]; then
  echo "--adopt-native-catalog applies to the Codex integration only." >&2
  exit 2
fi
if [ "$adopt_native_catalog" = true ]; then
  node src/legacy-migration.mjs assert-clear --adopt-native-catalog >/dev/null
else
  node src/legacy-migration.mjs assert-clear >/dev/null
fi
# Only the client-configuration step differs between targets; the provider
# selection, the gateway route table, and the service are one shared plane.
if [ "$target" = dsh ]; then
  config_manager=src/dsh-config-manager.mjs
  config_enable_command=install
  config_disable_command=uninstall
elif [ "$target" = gemini ]; then
  config_manager=src/gemini-config-manager.mjs
  config_enable_command=install
  config_disable_command=uninstall
elif [ "$target" = cursor ]; then
  config_manager=src/cursor-config-manager.mjs
  config_enable_command=install
  config_disable_command=uninstall
elif [ "$target" = claude ]; then
  config_manager=src/claude-code-config-manager.mjs
  config_enable_command=install
  config_disable_command=uninstall
else
  config_manager=src/config-manager.mjs
  config_enable_command=enable
  config_disable_command=disable
fi
node src/provider-selection.mjs ensure-configured >/dev/null
node src/secret.mjs ensure
config_enabled=false
service_installed=false
rollback() {
  if [ "$service_installed" = true ]; then
    node src/service.mjs uninstall >/dev/null 2>&1 || true
  fi
  if [ "$config_enabled" = true ]; then
    node "$config_manager" "$config_disable_command" >/dev/null 2>&1 || true
  elif [ "$adopt_native_catalog" = true ]; then
    node src/native-catalog-source.mjs clear-pending >/dev/null 2>&1 || true
  fi
}
trap rollback EXIT HUP INT TERM
if [ "$adopt_native_catalog" = true ]; then
  node src/native-catalog-source.mjs prepare-from-config >/dev/null
fi
# `catalog.mjs` asks the Codex CLI whether the session is signed in and refuses
# to publish when it cannot ask, so a harness-only machine never runs it.
state_dir=${MODEL_ROUTER_STATE_DIR:-${CODEX_ROUTER_STATE_DIR:-${KIMI_CODEX_STATE_DIR:-${CODEX_HOME:-$HOME/.codex}/codex-router}}}
if [ "$target" = codex ] || [ -s "$state_dir/native-models.json" ]; then
  node src/catalog.mjs
fi
node src/litellm-config.mjs
# The router plane is shared, so enabling for one client changes the routable
# set for the other. Republish whichever integration is already installed.
if [ "$target" != dsh ] && [ -s "$state_dir/dsh-models.json" ]; then
  node src/dsh-config-manager.mjs install >/dev/null
fi
if [ "$target" != gemini ] && [ -s "$state_dir/gemini-models.json" ]; then
  node src/gemini-config-manager.mjs install >/dev/null
fi
if [ "$target" != cursor ] && [ -s "$state_dir/cursor-models.json" ]; then
  if ! node src/cursor-config-manager.mjs status | grep -q '"running": true'; then
    node src/cursor-config-manager.mjs install >/dev/null
  fi
fi
if [ "$target" != claude ] && [ -s "$state_dir/claude-models.json" ]; then
  node src/claude-code-config-manager.mjs install >/dev/null
fi
config_enabled=true
if [ "$adopt_native_catalog" = true ]; then
  node "$config_manager" "$config_enable_command" --adopt-native-catalog
else
  node "$config_manager" "$config_enable_command"
fi
service_installed=true
node src/service.mjs install
node src/wait-health.mjs
config_enabled=false
service_installed=false
trap - EXIT HUP INT TERM
if [ "$target" = dsh ]; then
  echo "External model routes published to DeepSeek Harness. It reloads them on the next request."
  echo "Optional native GPT models: run 'codex login', then './bin/model-router codex chatgpt-session enable' once; every local client will reuse it."
elif [ "$target" = gemini ]; then
  echo "External model routes published to Gemini CLI. The next \`gemini\` run picks them up."
  echo "Choose \"Use Gemini API key\" once if it asks how to authenticate; the key is this router's local caller capability."
  echo "Optional native GPT models: run 'codex login', then './bin/model-router codex chatgpt-session enable' once; every local client will reuse it."
elif [ "$target" = cursor ]; then
  echo "External model routes published to Cursor. Run cursor-router-agent for the CLI."
  echo "Fully quit and reopen Cursor before using the new app models."
elif [ "$target" = claude ]; then
  echo "External model routes published to Claude Code. Run claude-router and choose a codex_router/anthropic/... model."
else
  echo "External model routes enabled. Fully quit and reopen Codex."
fi
