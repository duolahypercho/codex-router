#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"
# The service, gateway, ports, and credentials are one plane shared by every
# client integration -- the same reason `bin/disable` stopped tearing it down
# unconditionally. Uninstalling one client is not a reason to stop the other
# working, so the service goes only once nothing is pointed at it any more.
retire_service_if_unused() {
  remaining=$(node src/target-integration.mjs installed-targets)
  if [ -z "$remaining" ]; then
    node src/service.mjs uninstall
    echo "No client integrations remain, so the background service was removed."
  else
    echo "The background service is still running for: $remaining."
  fi
}

case "${MODEL_ROUTER_TARGET:-codex}" in
  codex)
    node src/config-manager.mjs disable
    node src/skills-install.mjs uninstall
    retire_service_if_unused
    echo "The Codex integration was removed."
    ;;
  dsh)
    node src/dsh-config-manager.mjs uninstall >/dev/null
    retire_service_if_unused
    echo "The DeepSeek Harness integration was removed."
    ;;
  *) echo "MODEL_ROUTER_TARGET must be codex or dsh." >&2; exit 2 ;;
esac
echo "The repository, cached native catalog, logs, and provider credentials were retained."
