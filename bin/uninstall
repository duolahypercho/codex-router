#!/bin/sh
set -eu

# The name on PATH may be a symlink to this script, so walk the chain before
# locating the repository root, and resolve that root physically: `dirname $0`
# alone points beside the link, and a logical `..` climbs out of a linked
# directory to a path node does not recognise as a module's own when it guards
# main, so the command would quietly do nothing.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname -- "$self")/$link ;;
  esac
done
repo_dir=$(CDPATH= cd -P -- "$(dirname -- "$self")/.." && pwd -P)
cd "$repo_dir"
# The service, gateway, ports, and credentials are one plane shared by every
# client integration -- the same reason `bin/disable` stopped tearing it down
# unconditionally. Uninstalling one client is not a reason to stop the other
# working, so the service goes only once nothing is pointed at it any more.
retire_service_if_unused() {
  remaining=$(node src/target-integration.mjs installed-targets)
  if [ -z "$remaining" ]; then
    node src/service.mjs uninstall
    echo "No client integrations remain, so the background service was removed."
  else
    if [ "${MODEL_ROUTER_TARGET:-codex}" = cursor ]; then
      # Removing Cursor must also retire its tunneled child listener even when
      # another client still needs the shared router service.
      node src/service.mjs install
    fi
    echo "The background service is still running for: $remaining."
  fi
}

case "${MODEL_ROUTER_TARGET:-codex}" in
  codex)
    node src/config-manager.mjs disable
    node src/skills-install.mjs uninstall
    # The shim is a file named `codex` on the user's PATH that execs this
    # checkout. Leaving it behind after the checkout is gone means every `codex`
    # they run from then on prints a warning about a router that is not coming
    # back. Removing an integration has to remove the thing standing in front of
    # it. Only marker-bearing files are touched, so a real `codex` is never at
    # risk, and there is nothing to remove on Windows.
    node src/shim-cli.mjs uninstall >/dev/null 2>&1 || true
    retire_service_if_unused
    echo "The Codex integration was removed."
    ;;
  dsh)
    node src/dsh-config-manager.mjs uninstall >/dev/null
    retire_service_if_unused
    echo "The DeepSeek Harness integration was removed."
    ;;
  gemini)
    node src/gemini-config-manager.mjs uninstall >/dev/null
    retire_service_if_unused
    echo "The Gemini CLI integration was removed."
    ;;
  cursor)
    node src/cursor-config-manager.mjs uninstall >/dev/null
    retire_service_if_unused
    echo "The Cursor integration was removed."
    ;;
  claude)
    node src/claude-code-config-manager.mjs uninstall >/dev/null
    retire_service_if_unused
    echo "The Claude Code integration was removed."
    ;;
  openclaw)
    node src/openclaw-config-manager.mjs uninstall >/dev/null
    retire_service_if_unused
    echo "The OpenClaw integration was removed. OpenClaw itself and all unrelated settings were retained."
    ;;
  *) echo "MODEL_ROUTER_TARGET must be codex, dsh, gemini, cursor, claude, or openclaw." >&2; exit 2 ;;
esac
echo "The repository, cached native catalog, logs, and provider credentials were retained."
