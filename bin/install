#!/bin/sh
set -eu

repo_dir=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
prepare_only=false
migrate_known=false
adopt_native_catalog=false
force_deps=false
target=${MODEL_ROUTER_TARGET:-codex}

case "$target" in
  codex|dsh|gemini|cursor|claude|openclaw) ;;
  *) echo "MODEL_ROUTER_TARGET must be codex, dsh, gemini, cursor, claude, or openclaw." >&2; exit 2 ;;
esac

for argument in "$@"; do
  case "$argument" in
    --prepare-only) prepare_only=true ;;
    --migrate-known) migrate_known=true ;;
    --adopt-native-catalog) adopt_native_catalog=true ;;
    --force-deps) force_deps=true ;;
    *) echo "Usage: $0 [--prepare-only] [--migrate-known] [--adopt-native-catalog] [--force-deps]" >&2; exit 2 ;;
  esac
done

# Installing is the sanctioned way for a checkout to take over a state
# directory: generated files are rebuilt here and the new owner is recorded at
# the end, so the ownership guard must not block this run. The override is
# scoped to that full install, and only after the arguments are known: a
# --prepare-only run rewrites the same generated state but exits before the
# manifest record, so letting it past the guard would let a second checkout
# rebuild foreign-owned state with no ownership transfer ever recorded.
if [ "$prepare_only" != true ]; then
  MODEL_ROUTER_ALLOW_FOREIGN_STATE=1
  export MODEL_ROUTER_ALLOW_FOREIGN_STATE
fi

if [ "$prepare_only" = true ] && [ "$migrate_known" = true ]; then
  echo "--prepare-only cannot migrate an active older router." >&2
  exit 2
fi
if [ "$prepare_only" = true ] && [ "$adopt_native_catalog" = true ]; then
  echo "--adopt-native-catalog cannot be used with --prepare-only." >&2
  exit 2
fi
if [ "$migrate_known" = true ] && [ "$adopt_native_catalog" = true ]; then
  echo "--adopt-native-catalog cannot be combined with --migrate-known." >&2
  exit 2
fi
# The native catalog is the ChatGPT-plan model list Codex ships and adopts.
# The harness has no equivalent and no ChatGPT session, so there is nothing for
# either flag to act on there.
if [ "$target" = dsh ] && [ "$adopt_native_catalog" = true ]; then
  echo "--adopt-native-catalog applies to the Codex integration only." >&2
  exit 2
fi
if [ "${CODEX_ROUTER_PACKAGE_MANAGER:-}" = homebrew ] && [ "$force_deps" = true ]; then
  echo "--force-deps cannot rebuild Homebrew-managed dependencies; run brew reinstall codex-router instead." >&2
  exit 2
fi

# Package managers assemble and own the dependency trees under their prefix.
# Refuse to mutate those trees even if a future installer integration reports a
# different dependency status, and leave the package-manager repair command in
# the error so the user has a safe recovery path.
packaged_dependency_refusal() {
  manager=${CODEX_ROUTER_PACKAGE_MANAGER:-}
  [ -z "$manager" ] && return 0
  if [ "$manager" = homebrew ]; then
    echo "Homebrew owns this installation; run brew reinstall codex-router to rebuild ${1:-dependencies}." >&2
  else
    echo "Reinstall the codex-router package managed by $manager to rebuild ${1:-dependencies}." >&2
  fi
  exit 1
}

platform=$(uname -s)
case "$platform" in
  Darwin|Linux) ;;
  *)
    if [ "$prepare_only" != true ]; then
      echo "Use install.ps1 for the native Windows installer." >&2
      exit 1
    fi
    ;;
esac
# A desktop app, a launchd/systemd service, and a package-manager hook are all
# started without the user's login-shell PATH, so a perfectly good Node can be
# invisible here and turn a routine catalog update into an install failure. An
# explicitly recorded runtime wins; otherwise the standard install locations
# are consulted, and only when the tool is not already resolvable.
prepend_path() {
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1:$PATH"; export PATH ;;
  esac
}
if [ -n "${CODEX_ROUTER_NODE_BIN:-}" ] && [ -x "${CODEX_ROUTER_NODE_BIN}" ]; then
  prepend_path "$(dirname -- "$CODEX_ROUTER_NODE_BIN")"
fi
for tool in node npm; do
  if command -v "$tool" >/dev/null 2>&1; then continue; fi
  for candidate in /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin" "$HOME/.npm-global/bin" "$HOME/.volta/bin" "$HOME/.asdf/shims"; do
    if [ -x "$candidate/$tool" ]; then
      prepend_path "$candidate"
      break
    fi
  done
done
for tool in node npm; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "$tool is required but was not found on PATH." >&2
    exit 1
  fi
done

node -e 'const [a,b]=process.versions.node.split(".").map(Number); if (!(a>22 || (a===22 && b>=19))) { console.error("Node.js 22.19 or newer is required."); process.exit(1) }'
if [ "$target" = openclaw ]; then
  node "$repo_dir/src/openclaw-install.mjs" preflight >/dev/null
fi

# Preserve the launcher selected by the operator. A compatibility wrapper may
# delegate to another runtime, so process.execPath is not necessarily the
# executable that should be placed in the background service.
CODEX_ROUTER_NODE_BIN=${CODEX_ROUTER_NODE_BIN:-$(command -v node)}
export CODEX_ROUTER_NODE_BIN

cd "$repo_dir"
codex_home=${CODEX_HOME:-$HOME/.codex}
mkdir -p "$codex_home"
if [ "$migrate_known" = true ]; then
  node src/legacy-migration.mjs apply --yes >/dev/null
else
  if [ "$adopt_native_catalog" = true ]; then
    node src/legacy-migration.mjs assert-clear --adopt-native-catalog >/dev/null
  else
    node src/legacy-migration.mjs assert-clear >/dev/null
  fi
fi
if [ "$prepare_only" != true ]; then
  node src/provider-selection.mjs ensure-configured >/dev/null
fi
# Every update re-runs this installer, so checkout-owned dependency steps are
# skipped when their inputs are unchanged; --force-deps (used by doctor --fix)
# rebuilds them. Homebrew assembles its dependency tree before this script runs.
install_step() {
  # A package-manager checkout already contains the dependency tree assembled
  # by that package manager. Re-running npm/pip here would mutate its managed
  # prefix and can fail when packages intentionally have no pip RECORD (as
  # Homebrew-installed Python resources do). The explicit --force-deps case is
  # rejected above with its package-manager repair command.
  if [ "${CODEX_ROUTER_PACKAGE_MANAGER:-}" = homebrew ]; then
    echo managed
  elif [ "$force_deps" = true ]; then
    echo run
  else
    node src/install-plan.mjs status "$1" 2>/dev/null || echo run
  fi
}

case "$(install_step node-deps)" in
  managed) echo "Homebrew manages Node dependencies; skipping npm ci." ;;
  skip) echo "Node dependencies already match package-lock.json; skipping npm ci." ;;
  *)
    packaged_dependency_refusal "Node dependencies"
    npm ci --omit=dev
    node src/install-plan.mjs record node-deps
    ;;
esac

ensure_uv_venv() {
  if [ ! -x .venv/bin/python ]; then
    if [ -e .venv ]; then
      echo "The virtual environment's Python launcher is missing; recreating the venv."
      uv venv --clear --python 3.12 .venv
    else
      uv venv --python 3.12 .venv
    fi
  elif ! .venv/bin/python -I -c 'import encodings, sys' >/dev/null 2>&1; then
    # A venv can have a present launcher whose interpreter cannot start
    # (for example after its temporary Python home was removed). Reusing it
    # lets uv install packages into a runtime that will never boot.
    echo "The virtual environment's Python cannot run; recreating the venv."
    uv venv --clear --python 3.12 .venv
  elif ! node src/install-plan.mjs venv-home-ok >/dev/null 2>&1; then
    # A venv whose interpreter home was cleared (macOS wipes /private/tmp,
    # and installers that recorded a temporary Python as the venv home end
    # up with a dangling interpreter) must be recreated, not pip-installed
    # into: the launcher may still exist while pyvenv.cfg points at a
    # vanished home.
    echo "The virtual environment's interpreter home is missing; recreating the venv."
    uv venv --clear --python 3.12 .venv
  fi
}

case "$(install_step python-deps)" in
  managed) echo "Homebrew manages LiteLLM; skipping Python dependency installation." ;;
  skip) echo "LiteLLM already matches the pinned versions; skipping the Python install." ;;
  *)
    packaged_dependency_refusal "LiteLLM"
    if command -v uv >/dev/null 2>&1; then
      ensure_uv_venv
      # requirements/python.txt is the hash-verified transitive closure of the
      # pins in src/install-plan.mjs. Hash checking makes every wheel and sdist
      # in that tree verify against the lock before it is executed; without it
      # only the two top-level packages were pinned and the rest was whatever
      # PyPI resolved that day. Regenerate the lock with bin/lock-python, never
      # by hand.
      uv pip install --python .venv/bin/python --require-hashes -r requirements/python.txt
      node src/install-plan.mjs record python-deps
    else
      if ! command -v python3 >/dev/null 2>&1; then
        echo "Python 3.10+ or uv is required to install LiteLLM." >&2
        exit 1
      fi
      python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else "Python 3.10 or newer is required.")'
      # Same clearing logic as the uv branch: a venv with a vanished interpreter
      # home must be recreated from scratch instead of installed over.
      if node src/install-plan.mjs venv-home-ok >/dev/null 2>&1 &&
        .venv/bin/python -I -c 'import encodings, sys' >/dev/null 2>&1; then
        # Keep a healthy venv as-is. Re-running `python3 -m venv` here can
        # rewrite pyvenv.cfg with a different system Python while preserving
        # the existing launcher, creating a mixed and unusable environment.
        :
      else
        echo "The virtual environment's interpreter home is missing; recreating the venv."
        python3 -m venv --clear .venv
      fi
      .venv/bin/python -m pip install --upgrade pip
      # Same hash-verified lock as the uv branch above; both branches stay checked.
      .venv/bin/python -m pip install --require-hashes -r requirements/python.txt
      node src/install-plan.mjs record python-deps
    fi
    ;;
esac

node src/secret.mjs ensure
config_enabled=false
service_installed=false
# Each target enables its own client configuration; everything above and below
# that one step is the shared router plane.
if [ "$target" = dsh ]; then
  config_manager=src/dsh-config-manager.mjs
  config_enable_command=install
  config_disable_command=uninstall
elif [ "$target" = gemini ]; then
  config_manager=src/gemini-config-manager.mjs
  config_enable_command=install
  config_disable_command=uninstall
elif [ "$target" = cursor ]; then
  config_manager=src/cursor-config-manager.mjs
  config_enable_command=install
  config_disable_command=uninstall
elif [ "$target" = claude ]; then
  config_manager=src/claude-code-config-manager.mjs
  config_enable_command=install
  config_disable_command=uninstall
elif [ "$target" = openclaw ]; then
  config_manager=src/openclaw-config-manager.mjs
  config_enable_command=install
  config_disable_command=uninstall
else
  config_manager=src/config-manager.mjs
  config_enable_command=enable
  config_disable_command=disable
fi
# What this run found before it changed anything. `service.mjs install` waits
# up to 300 seconds for the router to answer /health, and a LiteLLM gateway
# with a large model set can lose that race on a cold start -- a retryable
# hiccup, not a broken install. Rolling that back on a machine that already had
# a working router disabled the client config and tore out the LaunchAgent that
# were both fine before the run started, which turns a slow start into an
# unrouted machine. Rollback must only undo what this run created.
json_field() {
  node -e '
let raw = "";
process.stdin.on("data", (chunk) => { raw += chunk; });
process.stdin.on("end", () => {
  let value = "";
  try { value = String(JSON.parse(raw)[process.argv[1]] ?? ""); } catch {}
  process.stdout.write(value);
});
' "$1"
}
# Each manager reports enablement under its own name: the Codex/Gemini manager
# publishes a routing mode, the DSH manager reports whether its route is in the
# settings document.
if [ "$target" = dsh ]; then
  config_state_field=routeInstalled
  config_state_enabled=true
elif [ "$target" = gemini ]; then
  config_state_field=installed
  config_state_enabled=true
elif [ "$target" = cursor ]; then
  config_state_field=appConfigured
  config_state_enabled=true
elif [ "$target" = claude ]; then
  config_state_field=installed
  config_state_enabled=true
elif [ "$target" = openclaw ]; then
  config_state_field=installed
  config_state_enabled=true
else
  config_state_field=mode
  config_state_enabled=router
fi
config_was_enabled=false
if [ "$(node "$config_manager" status 2>/dev/null | json_field "$config_state_field")" = "$config_state_enabled" ]; then
  config_was_enabled=true
fi
service_was_installed=false
if [ "$(node src/service.mjs status 2>/dev/null | json_field installed)" = true ]; then
  service_was_installed=true
fi

rollback() {
  if [ "$service_installed" = true ] && [ "$service_was_installed" != true ]; then
    node src/service.mjs uninstall >/dev/null 2>&1 || true
  fi
  if [ "$config_enabled" = true ]; then
    if [ "$config_was_enabled" != true ]; then
      node "$config_manager" "$config_disable_command" >/dev/null 2>&1 || true
    fi
  elif [ "$adopt_native_catalog" = true ]; then
    node src/native-catalog-source.mjs clear-pending >/dev/null 2>&1 || true
  fi
}
state_dir=${MODEL_ROUTER_STATE_DIR:-${CODEX_ROUTER_STATE_DIR:-${KIMI_CODEX_STATE_DIR:-${CODEX_HOME:-$HOME/.codex}/codex-router}}}
trap rollback EXIT HUP INT TERM

# A parked login-free refresh deliberately leaves the user's direct provider
# active while its managed state remains protected by a journal. An ordinary
# install/doctor repair must not publish a new catalog and then mistake a plain
# config enable for recovery; only refresh-catalog owns that transaction.
node src/login-free-refresh-journal.mjs assert-clear
if [ "$adopt_native_catalog" = true ]; then
  node src/native-catalog-source.mjs prepare-from-config >/dev/null
fi
# Building the Codex catalog asks the Codex CLI whether the session is signed
# in, and refuses to publish when it cannot ask. A harness-only machine has no
# Codex to ask, so the catalog is built only when Codex is the target or an
# earlier Codex install already left one behind.
if [ "$target" = codex ]; then
  if [ -s "$state_dir/native-models.json" ]; then
    node src/catalog.mjs
  else
    node src/catalog.mjs --refresh-native --bundled-native
  fi
elif [ -s "$state_dir/native-models.json" ]; then
  node src/catalog.mjs
fi
node src/litellm-config.mjs
# The router plane is shared, so an install for one client changes the routable
# set for the other. Republish whichever integration is already installed here
# rather than leaving it advertising a stale model list.
if [ "$target" != dsh ] && [ -s "$state_dir/dsh-models.json" ]; then
  node src/dsh-config-manager.mjs install >/dev/null
fi
if [ "$target" != gemini ] && [ -s "$state_dir/gemini-models.json" ]; then
  node src/gemini-config-manager.mjs install >/dev/null
fi
if [ "$target" != cursor ] && [ -s "$state_dir/cursor-models.json" ]; then
  # Cursor owns a live SQLite settings document. Republish only while it is
  # stopped; a running app can overwrite the external transaction on exit.
  if ! node src/cursor-config-manager.mjs status | grep -q '"running": true'; then
    node src/cursor-config-manager.mjs install >/dev/null
  fi
fi
if [ "$target" != claude ] && [ -s "$state_dir/claude-models.json" ]; then
  node src/claude-code-config-manager.mjs install >/dev/null
fi
if [ "$target" != openclaw ] && [ -s "$state_dir/openclaw-models.json" ]; then
  node src/openclaw-config-manager.mjs install >/dev/null
fi

if [ "$prepare_only" = true ]; then
  echo "Dependencies and local Codex router files are prepared. Application configuration was not changed."
  exit 0
fi

if [ "$target" = openclaw ]; then
  node src/openclaw-install.mjs install >/dev/null
fi

config_enabled=true
if [ "$adopt_native_catalog" = true ]; then
  node "$config_manager" "$config_enable_command" --adopt-native-catalog
else
  node "$config_manager" "$config_enable_command"
fi
# Record before the service starts, not after. The generated state above was
# written by this checkout, so ownership is already this checkout's in fact;
# the manifest is provenance for exactly that -- which checkout owns the state,
# and the proxy environment a later repair must restore -- and the desktop app
# resolves its source root from the field. The service itself needs the record
# in place first: start.mjs rewrites the gateway config on every boot and
# refuses while the manifest still names another checkout, so recording after
# `service.mjs install` -- a step that contains the health wait -- let an
# install over a foreign-owned state directory crash-loop for the whole
# readiness budget while the ownership transfer it needed never ran.
node src/install-manifest.mjs record >/dev/null
service_installed=true
node src/service.mjs install
node src/wait-health.mjs
# A companion that is never rebuilt drifts behind the router on every update
# and keeps running its old binary. Rebuild only when one is already installed
# -- an update must not add a tray the user never asked for -- and only when
# the Swift sources actually changed, so a code-only update stays cheap.
# Best effort throughout: a missing Xcode toolchain must never cost someone
# their router update, and a non-zero exit here would roll the checkout back.
tray_plan=$(node src/install-plan.mjs tray-plan 2>/dev/null || echo absent)
case "$tray_plan" in
  rebuild)
    if [ "${CODEX_ROUTER_DEFER_TRAY_REBUILD:-0}" = 1 ]; then
      # A desktop UI can be the parent of doctor/update. Rebuilding it here
      # would ask that parent to quit while its mutation drain is waiting for
      # this installer, a circular wait. The UI launches `control tray refresh`
      # detached after this transaction returns.
      echo "Desktop companion rebuild deferred until the calling app drains."
    else
      # Keep the build output instead of discarding it: a swallowed failure here
      # is indistinguishable from success, and the companion would silently stay
      # on its old binary exactly as it did before this step existed.
      tray_log=$(mktemp)
      if "$repo_dir/bin/model-router-tray" --preserve-window >"$tray_log" 2>&1; then
        echo "Menu-bar companion rebuilt from the updated sources."
      else
        echo "Menu-bar companion could not be rebuilt; the router is installed. Retry with ./bin/model-router-tray." >&2
        sed 's/^/  /' "$tray_log" >&2
      fi
      rm -f "$tray_log"
    fi
    ;;
  skip)
    # A matching companion needs no process restart. Adopt it only when no
    # supervisor registration exists at all; calling `install` unconditionally
    # bootouts a loaded macOS host and also resurrects an app the user cleanly
    # quit. The status document is tri-state/fail-closed, so an unreadable or
    # unsupported supervisor is left untouched.
    if tray_status=$(node src/tray-service.mjs status 2>/dev/null) \
      && node -e '
        try {
          const status = JSON.parse(process.argv[1]);
          process.exit(status?.installed === false && status?.supported !== false ? 0 : 1);
        } catch {
          process.exit(1);
        }
      ' "$tray_status"
    then
      node src/tray-service.mjs install >/dev/null 2>&1 || true
    fi
    echo "Menu-bar companion already matches its sources; skipping the tray build."
    ;;
  disabled)
    echo "Menu-bar companion supervision is explicitly disabled; leaving it disabled."
    ;;
  unavailable)
    echo "Menu-bar companion supervision preference is unreadable; leaving the companion untouched." >&2
    ;;
esac
config_enabled=false
service_installed=false
trap - EXIT HUP INT TERM

# The skill pack teaches custom routed models how to use the app's native
# tools. Best effort: a skill install failure must never roll the router back.
# It targets Codex's own user-skill directory, so a harness install skips it.
if [ "$target" = codex ]; then
  node src/skills-install.mjs install
fi

if [ "$target" = dsh ]; then
  echo "Published the selected external model routes to DeepSeek Harness."
  echo "The harness reloads its settings document on the next request; no restart is needed."
elif [ "$target" = cursor ]; then
  echo "Published all routed models to Cursor Agent and Cursor App."
  echo "Run cursor-router-agent for the CLI; fully quit and reopen Cursor for the app."
elif [ "$target" = gemini ]; then
  echo "Published all routed models to Gemini CLI. The next gemini run picks them up."
elif [ "$target" = claude ]; then
  echo "Published all routed models to Claude Code. Run claude-router and choose a codex_router/anthropic/... model."
elif [ "$target" = openclaw ]; then
  echo "Installed OpenClaw and published every routed model under its codex-router provider."
  echo "Run openclaw to start; OpenClaw reads the route on the next agent run."
else
  echo "Installed the selected external model routes for Codex."
  # The configuration this install just rewrote is read once, at client start.
  # A client that was already running keeps serving the previous routing, and
  # the connection error that follows names neither the install nor the client.
  # So state which it is: running right now, or not running at all. A probe that
  # cannot answer must never fail an otherwise good install, hence the fallback.
  node src/target-integration.mjs restart-notice 2>/dev/null \
    || echo "Fully quit and reopen Codex, then start a new task."
fi
echo "Kimi API key: $repo_dir/bin/provider-key kimi-api set"
echo "DeepSeek API key: $repo_dir/bin/provider-key deepseek set"
echo "xAI API key: $repo_dir/bin/provider-key grok-api set"
echo "Anthropic API key: $repo_dir/bin/provider-key anthropic-api set"
echo "Chutes API key: $repo_dir/bin/provider-key chutes set"
