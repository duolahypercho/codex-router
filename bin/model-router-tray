#!/bin/sh
set -eu

# The name on PATH may be a symlink to this script, so walk the chain before
# locating the repository root, and resolve that root physically: `dirname $0`
# alone points beside the link, and a logical `..` climbs out of a linked
# directory to a path node does not recognise as a module's own when it guards
# main, so the command would quietly do nothing.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname -- "$self")/$link ;;
  esac
done
repo_dir=$(CDPATH='' cd -P -- "$(dirname -- "$self")/.." && pwd -P)
if [ "${CODEX_ROUTER_PACKAGE_MANAGER:-}" = homebrew ]; then
  printf '%s\n' \
    'codex-router: the desktop companion is not packaged by Homebrew.' \
    'Use the recommended curl installer in the README for the Electron Control Center, tray/menu-bar app, and macOS desktop widget.' >&2
  exit 2
fi
launch_mode=${1:-interactive}
case "$launch_mode" in
  interactive|--preserve-window|--tray-only) ;;
  *)
    printf 'Usage: %s [--preserve-window|--tray-only]\n' "$0" >&2
    exit 2
    ;;
esac

case $(uname -s) in
  Darwin)
    bundle_dir="$HOME/Applications/Codex Router.app"
    legacy_user_bundle="$HOME/Applications/Model Router.app"
    bundle_parent="$HOME/Applications"
    mkdir -p "$bundle_parent"
    transaction_dir="$bundle_parent/.model-router-tray-transaction"
    staging_dir="$transaction_dir/staged"
    staged_bundle="$staging_dir/Codex Router.app"
    previous_bundle="$transaction_dir/previous"
    failed_bundle="$transaction_dir/failed"
    phase_file="$transaction_dir/phase"
    next_phase_file="$transaction_dir/phase.next"
    had_previous_file="$transaction_dir/had-previous"
    target_name_file="$transaction_dir/target-name"
    artifact_set_file="$transaction_dir/artifact-set"
    embedded_app="$bundle_dir/Contents/Resources/Control Center.app"
    embedded_binary="$embedded_app/Contents/MacOS/Codex Router"
    transaction_committed=0
    reopen_control_center=0
    legacy_user_bundle_present=0
    legacy_user_bundle_is_managed() {
      candidate=$1
      [ -d "$candidate" ] && [ ! -L "$candidate" ] || return 1
      node "$repo_dir/src/macos-tray-transaction.mjs" validate-legacy-bundle "$candidate" \
        >/dev/null 2>&1 || return 1
      candidate_identifier=$(
        /usr/libexec/PlistBuddy -c "Print :CFBundleIdentifier" \
          "$candidate/Contents/Info.plist" 2>/dev/null
      ) || return 1
      [ "$candidate_identifier" = "io.github.codex-router.tray" ] || return 1
      /usr/bin/codesign --verify --deep --strict "$candidate" >/dev/null 2>&1
    }
    tray_app_count() {
      /usr/bin/osascript -l JavaScript -e '
        ObjC.import("AppKit");
        String(ObjC.unwrap(
          $.NSRunningApplication.runningApplicationsWithBundleIdentifier(
            "io.github.codex-router.tray"
          ).count
        ));
      '
    }
    tray_app_identity() {
      expected_bundle=$1
      # Count every outer host, then separately count only instances whose
      # AppKit bundle URL is the exact live replacement. One stale copy with the
      # same identifier must not satisfy readiness for a failed new binary.
      # Dollar expressions below are JXA template literals.
      # shellcheck disable=SC2016
      EXPECTED_BUNDLE="$expected_bundle" /usr/bin/osascript -l JavaScript -e '
        ObjC.import("AppKit");
        ObjC.import("Foundation");
        const environment = $.NSProcessInfo.processInfo.environment;
        const expectedBundle = ObjC.unwrap(environment.objectForKey("EXPECTED_BUNDLE"));
        const applications = $.NSRunningApplication.runningApplicationsWithBundleIdentifier(
          "io.github.codex-router.tray"
        );
        let matches = 0;
        for (let index = 0; index < applications.count; index += 1) {
          const bundleURL = applications.objectAtIndex(index).bundleURL;
          const bundlePath = bundleURL ? ObjC.unwrap(bundleURL.path) : "";
          if (bundlePath === expectedBundle) matches += 1;
        }
        `${Number(ObjC.unwrap(applications.count))} ${matches}`;
      '
    }
    router_app_count() {
      /usr/bin/osascript -l JavaScript -e '
        ObjC.import("AppKit");
        let total = 0;
        for (const identifier of ["io.github.codex-router.tray", "io.github.codex-router.control-center"]) {
          total += Number(ObjC.unwrap(
            $.NSRunningApplication.runningApplicationsWithBundleIdentifier(identifier).count
          ));
        }
        String(total);
      '
    }
    run_embedded_control_center() {
      /usr/bin/env -u ELECTRON_RUN_AS_NODE \
        CODEX_ROUTER_EMBEDDED_CONTROL_CENTER=1 "$@"
    }
    stop_uncommitted_tray() {
      recovery_bundle=$1
      recovery_embedded_binary="$recovery_bundle/Contents/Resources/Control Center.app/Contents/MacOS/Codex Router"
      # The renderer probe is launched directly, outside launchd. Ask that exact
      # embedded child to quit as well as booting out the outer Swift host; the
      # latter cannot be assumed to own a child whose renderer failed mid-boot.
      if [ -x "$recovery_embedded_binary" ]; then
        run_embedded_control_center "$recovery_embedded_binary" --quit-for-update \
          >/dev/null 2>&1 || true
      fi
      node "$repo_dir/src/tray-service.mjs" stop >/dev/null 2>&1 || return 1
      stop_wait=0
      while :; do
        running_count=$(router_app_count) || return 1
        case "$running_count" in *[!0-9]*|'') return 1 ;; esac
        [ "$running_count" -eq 0 ] && return 0
        if [ -x "$recovery_embedded_binary" ]; then
          run_embedded_control_center "$recovery_embedded_binary" --quit-for-update \
            >/dev/null 2>&1 || true
        fi
        stop_wait=$((stop_wait + 1))
        [ "$stop_wait" -ge 120 ] && return 1
        sleep 0.25
      done
    }
    schedule_macos_supervision_restore() {
      recovery_bundle=$1
      # The app may still be draining a provider/model mutation when this
      # installer is interrupted. A forceful launchctl restart here would kill
      # that work, while doing nothing leaves SuccessfulExit=false loaded but
      # stopped after the eventual clean exit. This anonymous helper outlives
      # the failed installer, waits for both real GUI bundles to disappear, and
      # only then asks launchd to resume its previously installed job.
      /usr/bin/nohup /bin/sh -s -- "$repo_dir" "$transaction_dir" "$recovery_bundle" >/dev/null 2>&1 <<'RESTORE_MACOS_SUPERVISION' &
trap '' HUP
repo_dir=$1
transaction_dir=$2
bundle_dir=$3
while :; do
  if ! running_count=$(/usr/bin/osascript -l JavaScript -e '
    ObjC.import("AppKit");
    let total = 0;
    for (const identifier of ["io.github.codex-router.tray", "io.github.codex-router.control-center"]) {
      total += Number(ObjC.unwrap(
        $.NSRunningApplication.runningApplicationsWithBundleIdentifier(identifier).count
      ));
    }
    String(total);
  '); then
    exit 0
  fi
  case "$running_count" in *[!0-9]*|'') exit 0 ;; esac
  [ "$running_count" -eq 0 ] && break
  sleep 1
done
if [ -e "$transaction_dir" ]; then
  recovery_fields=$(node "$repo_dir/src/macos-tray-transaction.mjs" \
    plan "$transaction_dir" "$bundle_dir") || exit 0
  # shellcheck disable=SC2086
  set -- $recovery_fields
  [ "$#" -eq 2 ] && [ "$1" = keep-live ] || exit 0
  rm -rf "$transaction_dir" || exit 0
fi
node "$repo_dir/src/tray-service.mjs" restart >/dev/null 2>&1 || true
RESTORE_MACOS_SUPERVISION
    }
    write_macos_phase() {
      journal_value=$1
      (umask 077; printf '%s\n' "$journal_value" >"$next_phase_file")
      chmod 600 "$next_phase_file"
      mv "$next_phase_file" "$phase_file"
    }
    recover_macos_transaction() {
      [ -e "$transaction_dir" ] || return 0
      recovery_bundle_dir=$bundle_dir
      recovery_service_action=install
      # Journals written before the visible app rename have no target marker.
      # Finish those against Model Router.app and its existing launchd plist;
      # every new journal identifies the Codex Router.app target explicitly.
      if [ ! -e "$target_name_file" ]; then
        recovery_bundle_dir=$legacy_user_bundle
        recovery_service_action=restart
      fi
      if ! recovery_fields=$(node "$repo_dir/src/macos-tray-transaction.mjs" \
        plan "$transaction_dir" "$recovery_bundle_dir"); then
        printf 'codex-router: refusing ambiguous macOS Codex Router recovery data at %s.\n' "$transaction_dir" >&2
        return 1
      fi
      # The validator emits exactly two fixed enum fields and rejects every
      # path, owner, mode, phase, or tree shape it does not understand.
      # shellcheck disable=SC2086
      set -- $recovery_fields
      [ "$#" -eq 2 ] || return 1
      recovery_action=$1
      next_action=$2
      case "$next_action" in
        none) ;;
        promote)
          [ ! -e "$phase_file" ] && [ -f "$next_phase_file" ] \
            && mv "$next_phase_file" "$phase_file" || return 1
          ;;
        discard) rm -f "$next_phase_file" ;;
        *) return 1 ;;
      esac

      restore_supervision=0
      case "$recovery_action" in
        none) return 0 ;;
        finalize)
          rm -rf "$transaction_dir"
          return 0
          ;;
        discard|finish-removed)
          ;;
        keep-live-intact)
          ;;
        keep-live)
          restore_supervision=1
          if running_count=$(router_app_count); then
            case "$running_count" in *[!0-9]*|'') return 1 ;; esac
            if [ "$running_count" -gt 0 ]; then
              schedule_macos_supervision_restore "$recovery_bundle_dir"
              printf 'codex-router: launchd supervision will resume after the running app finishes its active operation.\n' >&2
              return 1
            fi
          else
            return 1
          fi
          ;;
        restore-previous)
          [ ! -e "$recovery_bundle_dir" ] || return 1
          # Journal both sides of the move. If launchd installation fails (or
          # this shell dies) after the old bundle becomes live, the next run
          # recognizes `restoring-previous`/`previous-restored` and retries
          # supervision instead of demanding a backup that was already moved.
          write_macos_phase restoring-previous || return 1
          mv "$previous_bundle" "$recovery_bundle_dir" || return 1
          write_macos_phase previous-restored || return 1
          restore_supervision=1
          ;;
        replace-live-with-previous)
          if ! stop_uncommitted_tray "$recovery_bundle_dir"; then
            printf 'codex-router: the uncommitted Codex Router could not be stopped; recovery files were preserved.\n' >&2
            return 1
          fi
          [ ! -e "$failed_bundle" ] || return 1
          mv "$recovery_bundle_dir" "$failed_bundle" || return 1
          mv "$previous_bundle" "$recovery_bundle_dir" || return 1
          restore_supervision=1
          ;;
        finish-restored)
          restore_supervision=1
          ;;
        remove-live)
          if ! stop_uncommitted_tray "$recovery_bundle_dir"; then
            printf 'codex-router: the uncommitted first-install bundle could not be stopped; recovery files were preserved.\n' >&2
            return 1
          fi
          [ ! -e "$failed_bundle" ] || return 1
          mv "$recovery_bundle_dir" "$failed_bundle" || return 1
          ;;
        *) return 1 ;;
      esac

      if [ "$restore_supervision" -eq 1 ]; then
        if ! node "$repo_dir/src/tray-service.mjs" "$recovery_service_action" >/dev/null 2>&1; then
          printf 'codex-router: launchd supervision could not be restored automatically; recovery files were preserved.\n' >&2
          return 1
        fi
      fi
      rm -rf "$transaction_dir"
      return 0
    }
    cleanup_macos() {
      cleanup_status=$?
      trap - EXIT HUP INT TERM
      if [ "$transaction_committed" -eq 0 ] && [ -e "$transaction_dir" ]; then
        recover_macos_transaction \
          || printf 'codex-router: macOS Codex Router recovery remains at %s.\n' "$transaction_dir" >&2
      fi
      exit "$cleanup_status"
    }

    if [ -L "$bundle_dir" ] || { [ -e "$bundle_dir" ] && [ ! -d "$bundle_dir" ]; }; then
      printf 'codex-router: refusing a non-directory Codex Router target at %s.\n' "$bundle_dir" >&2
      exit 1
    fi
    recover_macos_transaction
    if [ -e "$transaction_dir" ]; then
      printf 'codex-router: refusing to overwrite a stale macOS Codex Router transaction.\n' >&2
      exit 1
    fi
    if [ -e "$legacy_user_bundle" ]; then
      if ! legacy_user_bundle_is_managed "$legacy_user_bundle"; then
        printf 'codex-router: refusing to remove an unrecognized legacy app at %s.\n' "$legacy_user_bundle" >&2
        exit 1
      fi
      legacy_user_bundle_present=1
    fi
    if [ -d "$bundle_dir" ] && [ "$legacy_user_bundle_present" -eq 1 ]; then
      printf 'codex-router: both Codex Router.app and the legacy Model Router.app exist; refusing an ambiguous replacement.\n' >&2
      exit 1
    fi
    mkdir -m 700 "$transaction_dir"
    mkdir -m 700 "$staging_dir"
    (umask 077; printf '%s\n' codex-router >"$target_name_file")
    chmod 600 "$target_name_file"
    (umask 077; printf '%s\n' widget-v1 >"$artifact_set_file")
    chmod 600 "$artifact_set_file"
    had_previous=0
    if [ -d "$bundle_dir" ] || [ "$legacy_user_bundle_present" -eq 1 ]; then
      had_previous=1
    fi
    (umask 077; printf '%s\n' "$had_previous" >"$had_previous_file")
    chmod 600 "$had_previous_file"
    write_macos_phase staging
    trap cleanup_macos EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    # Assemble and verify the replacement away from the live app. A failed
    # build leaves the running tray intact; overwriting its mapped signed pages
    # in place is what made macOS kill it as an invalid-signature process.
    "$repo_dir/scripts/build-macos-tray-app.sh" "$staged_bundle" >/dev/null
    write_macos_phase staged

    # NSRunningApplication names only real GUI bundle instances. The packaged
    # Electron binary also runs trusted Node children under the same executable
    # name during repair; process-name polling would mistake that updater for a
    # window and make it wait on its own parent forever.
    control_center_app_count() {
      /usr/bin/osascript -l JavaScript -e '
        ObjC.import("AppKit");
        String($.NSRunningApplication.runningApplicationsWithBundleIdentifier(
          "io.github.codex-router.control-center"
        ).count);
      '
    }
    terminate_router_apps() {
      /usr/bin/osascript -l JavaScript -e '
        ObjC.import("AppKit");
        for (const identifier of ["io.github.codex-router.tray", "io.github.codex-router.control-center"]) {
          const apps = $.NSRunningApplication.runningApplicationsWithBundleIdentifier(identifier);
          for (let index = 0; index < apps.count; index += 1) {
            apps.objectAtIndex(index).terminate;
          }
        }
      ' >/dev/null
    }
    queried_running=0
    queried_pid=0
    queried_ready=0
    queried_visible=0
    query_embedded_lifecycle() {
      lifecycle_json=$(
        run_embedded_control_center "$embedded_binary" --query-lifecycle 2>/dev/null
      ) || return 1
      # Dollar expressions below are JavaScript template literals.
      # shellcheck disable=SC2016
      lifecycle_fields=$(node -e '
        let parsed;
        try { parsed = JSON.parse(process.argv[1]); } catch { process.exit(1); }
        if (
          parsed === null
          || Array.isArray(parsed)
          || parsed.version !== 1
          || typeof parsed.running !== "boolean"
          || typeof parsed.ready !== "boolean"
          || typeof parsed.visible !== "boolean"
          || !(parsed.updatedAt === null || typeof parsed.updatedAt === "string")
          || (parsed.running && (!Number.isSafeInteger(parsed.pid) || parsed.pid < 1))
          || (!parsed.running && parsed.pid !== null)
          || (parsed.running && typeof parsed.updatedAt !== "string")
        ) process.exit(1);
        process.stdout.write(`${parsed.running ? 1 : 0} ${parsed.pid || 0} ${parsed.ready ? 1 : 0} ${parsed.visible ? 1 : 0}`);
      ' "$lifecycle_json") || return 1
      # The validated document emits exactly four decimal fields.
      # shellcheck disable=SC2086
      set -- $lifecycle_fields
      [ "$#" -eq 4 ] || return 1
      queried_running=$1
      queried_pid=$2
      queried_ready=$3
      queried_visible=$4
      return 0
    }
    control_center_identity_matches() {
      expected_bundle=$1
      expected_pid=$2
      # Dollar expressions below are JXA template literals.
      # shellcheck disable=SC2016
      identity=$(
        EXPECTED_BUNDLE="$expected_bundle" EXPECTED_PID="$expected_pid" \
          /usr/bin/osascript -l JavaScript -e '
            ObjC.import("AppKit");
            ObjC.import("Foundation");
            const environment = $.NSProcessInfo.processInfo.environment;
            const expectedBundle = ObjC.unwrap(environment.objectForKey("EXPECTED_BUNDLE"));
            const expectedPid = Number(ObjC.unwrap(environment.objectForKey("EXPECTED_PID")));
            const applications = $.NSRunningApplication.runningApplicationsWithBundleIdentifier(
              "io.github.codex-router.control-center"
            );
            let matches = 0;
            for (let index = 0; index < applications.count; index += 1) {
              const application = applications.objectAtIndex(index);
              const bundleURL = application.bundleURL;
              const bundlePath = bundleURL ? ObjC.unwrap(bundleURL.path) : "";
              if (Number(application.processIdentifier) === expectedPid && bundlePath === expectedBundle) {
                matches += 1;
              }
            }
            `${Number(ObjC.unwrap(applications.count))} ${matches}`;
          '
      ) || return 1
      # The JXA program emits exactly two decimal fields.
      # shellcheck disable=SC2086
      set -- $identity
      [ "$#" -eq 2 ] || return 1
      [ "$1" -eq 1 ] && [ "$2" -eq 1 ]
    }
    stop_embedded_control_center() {
      run_embedded_control_center "$embedded_binary" --quit-for-update \
        >/dev/null 2>&1 || return 1
      embedded_stop_wait=0
      while [ "$embedded_stop_wait" -lt 120 ]; do
        if query_embedded_lifecycle && [ "$queried_running" -eq 0 ]; then
          if ! embedded_count=$(control_center_app_count); then return 1; fi
          case "$embedded_count" in *[!0-9]*|'') return 1 ;; esac
          [ "$embedded_count" -eq 0 ] && return 0
        fi
        embedded_stop_wait=$((embedded_stop_wait + 1))
        sleep 0.25
      done
      return 1
    }

    # A tray opened by hand is outside launchd's reach, so ask every indexed
    # GUI instance to quit after the staged replacement passes verification.
    staged_embedded_binary="$staged_bundle/Contents/Resources/Control Center.app/Contents/MacOS/Codex Router"
    if [ "$launch_mode" = interactive ]; then
      reopen_control_center=1
    elif [ "$launch_mode" = --preserve-window ]; then
      if ! control_center_count=$(control_center_app_count); then
        printf 'codex-router: the open Control Center state could not be read; the app was not replaced.\n' >&2
        exit 1
      fi
      case "$control_center_count" in *[!0-9]*|'') exit 1 ;; esac
      if [ "$control_center_count" -gt 0 ]; then
        reopen_control_center=1
      fi
    fi
    write_macos_phase draining
    if ! terminate_router_apps; then
      printf 'codex-router: the running Codex Router apps could not be asked to quit; the app was not replaced.\n' >&2
      exit 1
    fi
    # A pre-unification standalone app used the same Control Center bundle id
    # and Electron single-instance lock. Launching the staged binary with the
    # update request reaches whichever old/new copy owns that lock, so it
    # drains and exits before the one canonical bundle is installed.
    if [ -x "$staged_embedded_binary" ]; then
      run_embedded_control_center "$staged_embedded_binary" --quit-for-update \
        >/dev/null 2>&1 || true
    fi
    # The Control Center defers app.quit() until any provider/model mutation
    # has drained. Never replace or delete its signed mapped bundle while that
    # process is still alive; doing so can invalidate the process and lose the
    # mutation it was protecting.
    wait_count=0
    while :; do
      if ! running_count=$(router_app_count); then
        printf 'codex-router: the running Codex Router apps could not be inspected; the app was not replaced.\n' >&2
        exit 1
      fi
      case "$running_count" in *[!0-9]*|'') exit 1 ;; esac
      [ "$running_count" -eq 0 ] && break
      wait_count=$((wait_count + 1))
      if [ "$wait_count" -ge 720 ]; then
        printf 'codex-router: the running Codex Router did not finish its active operation; the app was not replaced.\n' >&2
        exit 1
      fi
      # A clean AppKit exit does not satisfy launchd's SuccessfulExit=false
      # restart condition. Repeating the request also catches a rare abnormal
      # exit/restart without force-killing a mutation that is still draining.
      terminate_router_apps || true
      sleep 1
    done
    write_macos_phase drained

    # Only boot the job out after the GUI has drained. launchctl may escalate a
    # stop from TERM to KILL after ExitTimeOut, so doing this first would defeat
    # the application's terminate-later guarantee on a long provider mutation.
    write_macos_phase supervision-stopping
    if ! node "$repo_dir/src/tray-service.mjs" stop >/dev/null; then
      printf 'codex-router: launchd would not release the current Codex Router; the app was not replaced.\n' >&2
      exit 1
    fi
    write_macos_phase supervision-stopped

    write_macos_phase previous-moving
    if [ -d "$bundle_dir" ]; then
      mv "$bundle_dir" "$previous_bundle"
    elif [ "$legacy_user_bundle_present" -eq 1 ]; then
      mv "$legacy_user_bundle" "$previous_bundle"
    fi
    write_macos_phase previous-moved
    write_macos_phase replacement-moving
    if ! mv "$staged_bundle" "$bundle_dir"; then
      printf 'codex-router: could not install the rebuilt tray bundle.\n' >&2
      exit 1
    fi
    write_macos_phase replacement-installed
    # launchd owns the companion from here. Installing the agent starts it now,
    # starts it at every login, and restarts it if it ever exits abnormally --
    # a login item alone only covers the login case, which left a crashed tray
    # gone until the next one.
    # Ignore signals in this parent only while launchd adopts the verified
    # replacement and the rollback flags commit. The child resets them, so an
    # interrupt still aborts registration and takes the normal rollback path.
    trap '' HUP INT TERM
    write_macos_phase replacement-starting
    if ! (trap - HUP INT TERM; node "$repo_dir/src/tray-service.mjs" install >/dev/null); then
      trap 'exit 129' HUP
      trap 'exit 130' INT
      trap 'exit 143' TERM
      printf 'codex-router: launchd would not accept the rebuilt Codex Router; the previous app will be restored.\n' >&2
      exit 1
    fi
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    # Registration is not readiness: bootstrap can return just before the app
    # crashes, or a stale copy can satisfy the bundle identifier. Commit only
    # while AppKit reports exactly one outer host and its bundle URL is the exact
    # live replacement path.
    replacement_ready=0
    readiness_count=unknown
    readiness_matches=unknown
    readiness_wait=0
    while [ "$readiness_wait" -lt 120 ]; do
      if ! readiness_identity=$(tray_app_identity "$bundle_dir"); then break; fi
      # The JXA program emits exactly two decimal fields.
      # shellcheck disable=SC2086
      set -- $readiness_identity
      [ "$#" -eq 2 ] || break
      readiness_count=$1
      readiness_matches=$2
      case "$readiness_count" in *[!0-9]*|'') break ;; esac
      case "$readiness_matches" in *[!0-9]*|'') break ;; esac
      if [ "$readiness_count" -eq 1 ] && [ "$readiness_matches" -eq 1 ]; then
        replacement_ready=1
        break
      fi
      # More than one outer host is a duplicate installation, not a state that
      # waiting can make safe to commit.
      [ "$readiness_count" -gt 1 ] && break
      readiness_wait=$((readiness_wait + 1))
      sleep 0.25
    done
    if [ "$replacement_ready" -ne 1 ]; then
      printf 'codex-router: the rebuilt Codex Router did not start as the exact live native host (count: %s, live matches: %s); the previous app will be restored.\n' "$readiness_count" "$readiness_matches" >&2
      exit 1
    fi
    write_macos_phase replacement-ready

    # The outer Swift host can be healthy while its embedded Electron package
    # is missing a renderer or cannot establish its privileged lifecycle. Start
    # one hidden packaged child, then accept it only when the child's strict
    # lifecycle record points to the one AppKit instance inside this exact live
    # bundle. The previous bundle remains available throughout this probe.
    embedded_app="$bundle_dir/Contents/Resources/Control Center.app"
    embedded_binary="$embedded_app/Contents/MacOS/Codex Router"
    if [ ! -x "$embedded_binary" ]; then
      printf 'codex-router: the rebuilt Codex Router has no executable embedded Control Center; the previous app will be restored.\n' >&2
      exit 1
    fi
    run_embedded_control_center "$embedded_binary" --tray-only \
      >/dev/null 2>&1 &
    embedded_renderer_ready=0
    embedded_readiness_wait=0
    while [ "$embedded_readiness_wait" -lt 120 ]; do
      if query_embedded_lifecycle \
        && [ "$queried_running" -eq 1 ] \
        && [ "$queried_ready" -eq 1 ] \
        && control_center_identity_matches "$embedded_app" "$queried_pid"
      then
        embedded_renderer_ready=1
        break
      fi
      embedded_readiness_wait=$((embedded_readiness_wait + 1))
      sleep 0.25
    done
    if [ "$embedded_renderer_ready" -ne 1 ]; then
      printf 'codex-router: the rebuilt Control Center renderer did not become ready; the previous app will be restored.\n' >&2
      exit 1
    fi
    write_macos_phase embedded-ready

    # Login and tray-only refreshes must not leave an invisible Electron child
    # behind merely because it was used to validate the package. An interrupted
    # visible Control Center remains alive and receives the normal reopen event
    # after the transaction commits.
    if [ "$reopen_control_center" -eq 0 ] && ! stop_embedded_control_center; then
      printf 'codex-router: the validated Control Center did not stop cleanly; the previous app will be restored.\n' >&2
      exit 1
    fi

    write_macos_phase committed
    transaction_committed=1
    rm -rf "$transaction_dir"
    # launchd intentionally starts the replacement with --supervised, which
    # keeps login starts tray-only. If this rebuild interrupted an open Control
    # Center, send one normal reopen event after registration so the new outer
    # host restores that window instead of leaving the user with only a tray.
    if [ "$reopen_control_center" -eq 1 ]; then
      /usr/bin/open "$bundle_dir"
    fi
    # Not silenced: without the stamp every later update rebuilds the companion
    # from scratch, which is the cost this step exists to avoid. Losing it is
    # wasteful rather than dangerous, so say so and carry on.
    node "$repo_dir/src/install-plan.mjs" record-tray >/dev/null \
      || printf 'codex-router: could not stamp the companion build; the next update will rebuild it.\n' >&2
    # Companions built before the per-user move sit inside the checkout. The
    # agent now points at the shared bundle, so the old copy is dead weight
    # that a stray `open` could still launch alongside the real one.
    legacy_bundle="$repo_dir/dist/Model Router.app"
    if [ -d "$legacy_bundle" ] && [ "$legacy_bundle" != "$bundle_dir" ]; then
      rm -rf "$legacy_bundle"
      printf 'Removed the superseded in-checkout companion: %s\n' "$legacy_bundle"
    fi
    trap - EXIT HUP INT TERM
    printf 'Tray installed and supervised by launchd: %s\n' "$bundle_dir"
    ;;
  Linux)
    release_dir="$repo_dir/apps/control-center/release"
    target_dir="$release_dir/linux-unpacked"
    binary_path="$target_dir/codex-router-control-center"
    transaction_dir="$release_dir/.linux-control-center-transaction"
    staged_dir="$transaction_dir/staged"
    backup_dir="$transaction_dir/previous"
    failed_dir="$transaction_dir/failed"
    phase_file="$transaction_dir/phase"
    next_phase_file="$transaction_dir/phase.next"
    had_previous_file="$transaction_dir/had-previous"
    restart_records_file="$transaction_dir/restart-records"
    staged_binary="$staged_dir/codex-router-control-center"
    prior_visible=0
    new_pid=0
    transaction_committed=0
    queried_running=0
    queried_ready=0
    queried_visible=0
    queried_pid=0
    current_uid=$(id -u)
    legacy_tauri_binary="$repo_dir/apps/desktop/src-tauri/target/release/codex-router-desktop"
    legacy_electron_binary="$repo_dir/apps/electron/node_modules/electron/dist/electron"
    legacy_electron_app="$repo_dir/apps/electron"

    validate_linux_release_root() {
      for required_directory in \
        "$repo_dir/apps" \
        "$repo_dir/apps/control-center" \
        "$release_dir"; do
        [ -d "$required_directory" ] && [ ! -L "$required_directory" ] || return 1
      done
      control_center_real=$(CDPATH='' cd -P -- "$repo_dir/apps/control-center" && pwd -P) || return 1
      release_real=$(CDPATH='' cd -P -- "$release_dir" && pwd -P) || return 1
      [ "$release_real" = "$control_center_real/release" ]
    }

    prepare_linux_release_root() {
      for required_directory in "$repo_dir/apps" "$repo_dir/apps/control-center"; do
        [ -d "$required_directory" ] && [ ! -L "$required_directory" ] || return 1
      done
      if [ -L "$release_dir" ] || { [ -e "$release_dir" ] && [ ! -d "$release_dir" ]; }; then
        return 1
      fi
      mkdir -p "$release_dir" || return 1
      validate_linux_release_root
    }

    sync_linux_entries() {
      # A journal rename is not durable until both the file and containing
      # directory have reached stable storage. O_NOFOLLOW plus inode equality
      # also prevents this helper from turning a late symlink swap into an
      # fsync of an unrelated current-user path.
      # Dollar expressions below are JavaScript template literals.
      # shellcheck disable=SC2016
      node -e '
        const fs = require("node:fs");
        for (const entry of process.argv.slice(1)) {
          const before = fs.lstatSync(entry);
          if (before.isSymbolicLink()) throw new Error(`refusing linked durability path: ${entry}`);
          let flags = fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW || 0);
          if (before.isDirectory()) flags |= fs.constants.O_DIRECTORY || 0;
          const descriptor = fs.openSync(entry, flags);
          try {
            const opened = fs.fstatSync(descriptor);
            if (opened.dev !== before.dev || opened.ino !== before.ino) {
              throw new Error(`durability path changed while opening: ${entry}`);
            }
            fs.fsyncSync(descriptor);
          } finally {
            fs.closeSync(descriptor);
          }
        }
      ' "$@"
    }

    durable_linux_move() {
      move_source=$1
      move_destination=$2
      validate_linux_release_root || {
        printf 'codex-router: refusing a Linux Control Center move through an unsafe release directory.\n' >&2
        return 1
      }
      case "$move_source" in "$release_dir"/*) ;; *) return 1 ;; esac
      case "$move_destination" in "$release_dir"/*) ;; *) return 1 ;; esac
      move_source_parent=${move_source%/*}
      move_destination_parent=${move_destination%/*}
      mv "$move_source" "$move_destination" || return 1
      if [ "$move_source_parent" = "$move_destination_parent" ]; then
        sync_linux_entries "$move_source_parent"
      else
        sync_linux_entries "$move_source_parent" "$move_destination_parent"
      fi
    }

    durable_linux_remove() {
      remove_target=$1
      validate_linux_release_root || {
        printf 'codex-router: refusing Linux Control Center cleanup through an unsafe release directory.\n' >&2
        return 1
      }
      case "$remove_target" in "$release_dir"/*) ;; *) return 1 ;; esac
      remove_parent=${remove_target%/*}
      rm -rf "$remove_target" || return 1
      sync_linux_entries "$remove_parent"
    }

    remove_obsolete_linux_tauri() {
      legacy_tauri_removed=0
      [ -e "$legacy_tauri_binary" ] || [ -L "$legacy_tauri_binary" ] || return 0
      for legacy_directory in \
        "$repo_dir/apps" \
        "$repo_dir/apps/desktop" \
        "$repo_dir/apps/desktop/src-tauri" \
        "$repo_dir/apps/desktop/src-tauri/target" \
        "$repo_dir/apps/desktop/src-tauri/target/release"; do
        [ -d "$legacy_directory" ] && [ ! -L "$legacy_directory" ] || return 1
      done
      [ -f "$legacy_tauri_binary" ] && [ ! -L "$legacy_tauri_binary" ] || return 1
      rm -f "$legacy_tauri_binary" || return 1
      legacy_tauri_removed=1
    }

    pid_running() {
      case ${1:-} in ''|*[!0-9]*) return 1 ;; esac
      [ "$1" -gt 0 ] || return 1
      if [ -r "/proc/$1/stat" ]; then
        process_state=$(sed -n 's/^.*) //p' "/proc/$1/stat" 2>/dev/null \
          | awk '{ print $1 }' || true)
        [ "$process_state" = Z ] && return 1
      fi
      kill -0 "$1" >/dev/null 2>&1
    }

    pid_start_identity() {
      candidate_pid=$1
      [ -r "/proc/$candidate_pid/stat" ] || return 1
      # proc(5) field 22 is the kernel start-time tick. Strip pid/comm through
      # the last `) ` first because comm may contain spaces or parentheses; the
      # start tick is then field 20 in the remaining record.
      candidate_start=$(sed -n 's/^.*) //p' "/proc/$candidate_pid/stat" 2>/dev/null \
        | awk '{ print $20 }' || true)
      case "$candidate_start" in ''|*[!0-9]*) return 1 ;; esac
      [ "$candidate_start" -gt 0 ] || return 1
      printf '%s\n' "$candidate_start"
    }

    pid_has_base_identity() {
      candidate_pid=$1
      candidate_binary=$2
      pid_running "$candidate_pid" || return 1
      [ -r "/proc/$candidate_pid/status" ] || return 1
      candidate_uid=$(awk '/^Uid:/{ print $2; exit }' "/proc/$candidate_pid/status" 2>/dev/null || true)
      [ "$candidate_uid" = "$current_uid" ] || return 1
      expected_binary=$(readlink -f "$candidate_binary" 2>/dev/null || printf '%s' "$candidate_binary")
      actual_binary=$(readlink "/proc/$candidate_pid/exe" 2>/dev/null || true)
      [ "$actual_binary" = "$expected_binary" ] || return 1
      return 0
    }

    pid_has_exact_argv() {
      candidate_pid=$1
      expected_argument=${2-}
      [ -r "/proc/$candidate_pid/cmdline" ] || return 1
      argument_count=$(tr '\000' '\n' <"/proc/$candidate_pid/cmdline" 2>/dev/null \
        | awk 'END { print NR }')
      if [ -z "$expected_argument" ]; then
        [ "$argument_count" -eq 1 ]
        return
      fi
      [ "$argument_count" -eq 2 ] || return 1
      actual_argument=$(tr '\000' '\n' <"/proc/$candidate_pid/cmdline" 2>/dev/null \
        | sed -n '2p')
      [ "$actual_argument" = "$expected_argument" ]
    }

    pid_is_electron_gui() {
      candidate_pid=$1
      [ -r "/proc/$candidate_pid/environ" ] || return 1
      if tr '\000' '\n' <"/proc/$candidate_pid/environ" 2>/dev/null \
        | grep -q '^ELECTRON_RUN_AS_NODE='; then
        return 1
      fi
      return 0
    }

    control_center_launch_shape() {
      candidate_pid=$1
      candidate_binary=$2
      pid_has_base_identity "$candidate_pid" "$candidate_binary" || return 1
      pid_is_electron_gui "$candidate_pid" || return 1
      if pid_has_exact_argv "$candidate_pid"; then
        printf 'visible\n'
        return 0
      fi
      if pid_has_exact_argv "$candidate_pid" --tray-only; then
        printf 'tray\n'
        return 0
      fi
      return 1
    }

    pid_is_control_center_gui() {
      control_center_launch_shape "$1" "$2" >/dev/null
    }

    pid_is_legacy_tauri() {
      pid_has_base_identity "$1" "$legacy_tauri_binary" \
        && pid_has_exact_argv "$1"
    }

    pid_is_legacy_electron() {
      pid_has_base_identity "$1" "$legacy_electron_binary" \
        && pid_is_electron_gui "$1" \
        && pid_has_exact_argv "$1" "$legacy_electron_app"
    }

    query_control_center() {
      queried_running=0
      queried_ready=0
      queried_visible=0
      queried_pid=0
      [ -x "$1" ] || return 1
      if ! lifecycle_json=$(env -u ELECTRON_RUN_AS_NODE "$1" --query-lifecycle 2>/dev/null); then
        return 1
      fi
      # Dollar expressions below are JavaScript template literals.
      # shellcheck disable=SC2016
      if ! lifecycle_fields=$(node -e '
        const state = JSON.parse(process.argv[1]);
        if (state?.version !== 1 || typeof state.running !== "boolean" ||
            typeof state.ready !== "boolean" || typeof state.visible !== "boolean" ||
            (state.pid !== null && (!Number.isSafeInteger(state.pid) || state.pid < 1)) ||
            state.running !== (state.pid !== null) || (!state.running && (state.ready || state.visible))) process.exit(2);
        process.stdout.write(`${state.running ? 1 : 0}:${state.ready ? 1 : 0}:${state.visible ? 1 : 0}:${state.pid || 0}`);
      ' "$lifecycle_json" 2>/dev/null); then
        return 1
      fi
      case "$lifecycle_fields" in [01]:[01]:[01]:[0-9]*) ;; *) return 1 ;; esac
      queried_running=${lifecycle_fields%%:*}
      lifecycle_fields=${lifecycle_fields#*:}
      queried_ready=${lifecycle_fields%%:*}
      lifecycle_fields=${lifecycle_fields#*:}
      queried_visible=${lifecycle_fields%%:*}
      queried_pid=${lifecycle_fields#*:}
    }

    start_control_center() {
      start_binary=$1
      start_visible=$2
      if [ "$start_visible" -eq 1 ]; then
        nohup env -u ELECTRON_RUN_AS_NODE "$start_binary" >/dev/null 2>&1 &
      else
        nohup env -u ELECTRON_RUN_AS_NODE "$start_binary" --tray-only >/dev/null 2>&1 &
      fi
      control_center_pid=$!
      sleep 1
      if ! pid_running "$control_center_pid"; then
        wait "$control_center_pid" 2>/dev/null || true
        return 1
      fi
    }

    linux_package_complete() {
      package_dir=$1
      package_binary="$package_dir/codex-router-control-center"
      package_resources="$package_dir/resources"
      package_archive="$package_resources/app.asar"
      [ -d "$package_dir" ] && [ ! -L "$package_dir" ] \
        && [ -d "$package_resources" ] && [ ! -L "$package_resources" ] \
        && [ -f "$package_binary" ] && [ ! -L "$package_binary" ] \
        && [ -s "$package_binary" ] && [ -x "$package_binary" ] \
        && [ -f "$package_archive" ] && [ ! -L "$package_archive" ] \
        && [ -s "$package_archive" ]
    }

    sync_linux_package() {
      package_dir=$1
      linux_package_complete "$package_dir" || return 1
      sync_linux_entries \
        "$package_dir/codex-router-control-center" \
        "$package_dir/resources/app.asar" \
        "$package_dir/resources" \
        "$package_dir" \
        "$release_dir"
    }

    stop_control_center_gracefully() {
      stop_binary=$1
      stop_pid=$2
      pid_is_control_center_gui "$stop_pid" "$stop_binary" || return 0
      if ! env -u ELECTRON_RUN_AS_NODE "$stop_binary" --quit-for-update >/dev/null 2>&1; then
        return 1
      fi
      stop_wait=0
      while pid_is_control_center_gui "$stop_pid" "$stop_binary" && [ "$stop_wait" -lt 720 ]; do
        stop_wait=$((stop_wait + 1))
        sleep 1
      done
      ! pid_is_control_center_gui "$stop_pid" "$stop_binary"
    }

    record_is_running() {
      record_kind=$1
      record_pid=$2
      case "$record_kind" in
        canonical) pid_is_control_center_gui "$record_pid" "$binary_path" ;;
        tauri) pid_is_legacy_tauri "$record_pid" ;;
        electron) pid_is_legacy_electron "$record_pid" ;;
        *) return 1 ;;
      esac
    }

    capture_record_start() {
      capture_kind=$1
      capture_pid=$2
      capture_before=$(pid_start_identity "$capture_pid") || return 1
      record_is_running "$capture_kind" "$capture_pid" || return 1
      capture_after=$(pid_start_identity "$capture_pid") || return 1
      [ "$capture_before" = "$capture_after" ] || return 1
      printf '%s\n' "$capture_before"
    }

    record_matches_bound_identity() {
      bound_kind=$1
      bound_pid=$2
      bound_start=$3
      case "$bound_start" in ''|*[!0-9]*) return 1 ;; esac
      current_start=$(pid_start_identity "$bound_pid") || return 1
      [ "$current_start" = "$bound_start" ] || return 1
      record_is_running "$bound_kind" "$bound_pid" || return 1
      current_start=$(pid_start_identity "$bound_pid") || return 1
      [ "$current_start" = "$bound_start" ]
    }

    stop_exact_record() {
      record_kind=$1
      record_pid=$2
      record_start=$3
      case "$record_kind" in tauri|electron) ;; *) return 1 ;; esac
      record_matches_bound_identity "$record_kind" "$record_pid" "$record_start" || return 0
      # Revalidate executable, argv, uid, and the captured kernel start tick in
      # the final operation immediately before each signal. A reused numeric PID
      # is treated as the old process having exited and is never signalled.
      record_matches_bound_identity "$record_kind" "$record_pid" "$record_start" || return 0
      kill -TERM "$record_pid" >/dev/null 2>&1 || true
      stop_wait=0
      while record_matches_bound_identity "$record_kind" "$record_pid" "$record_start" \
        && [ "$stop_wait" -lt 5 ]; do
        stop_wait=$((stop_wait + 1))
        sleep 1
      done
      if record_matches_bound_identity "$record_kind" "$record_pid" "$record_start"; then
        record_matches_bound_identity "$record_kind" "$record_pid" "$record_start" || return 0
        kill -KILL "$record_pid" >/dev/null 2>&1 || true
        stop_wait=0
        while record_matches_bound_identity "$record_kind" "$record_pid" "$record_start" \
          && [ "$stop_wait" -lt 5 ]; do
          stop_wait=$((stop_wait + 1))
          sleep 1
        done
      fi
      ! record_matches_bound_identity "$record_kind" "$record_pid" "$record_start"
    }

    stop_recorded_processes() {
      [ -f "$restart_records_file" ] || return 0
      while IFS=: read -r record_kind record_pid record_start record_visible record_graceful; do
        [ -n "$record_kind" ] || continue
        if [ "$record_kind" = canonical ]; then
          if [ "$record_graceful" != 1 ]; then
            printf 'codex-router: the running Control Center has no verified lifecycle owner; close it normally and retry. It was not force-stopped.\n' >&2
            return 1
          fi
          if ! record_matches_bound_identity canonical "$record_pid" "$record_start"; then
            if record_is_running canonical "$record_pid"; then
              printf 'codex-router: the recorded Control Center PID now has a different start identity; it was not stopped.\n' >&2
              return 1
            fi
            continue
          fi
          if ! stop_control_center_gracefully "$binary_path" "$record_pid"; then
            printf 'codex-router: the running Control Center did not finish its active operation; it was not rebuilt.\n' >&2
            return 1
          fi
        elif ! stop_exact_record "$record_kind" "$record_pid" "$record_start"; then
          printf 'codex-router: a recognized legacy companion process could not be stopped safely (pid %s).\n' "$record_pid" >&2
          return 1
        fi
      done <"$restart_records_file"

      # Close the capture-to-swap window without guessing. A companion that
      # appeared after the durable record has no bound start identity, so refuse
      # the rebuild and let the user close it rather than signalling it by PID.
      for process in /proc/[0-9]*; do
        candidate_pid=${process##*/}
        if pid_is_control_center_gui "$candidate_pid" "$binary_path"; then
          printf 'codex-router: a Control Center appeared after lifecycle capture (pid %s); close it normally and retry. It was not force-stopped.\n' "$candidate_pid" >&2
          return 1
        fi
        if pid_is_legacy_tauri "$candidate_pid" || pid_is_legacy_electron "$candidate_pid"; then
          printf 'codex-router: a legacy companion appeared after process capture (pid %s); retry after it exits. It was not force-stopped.\n' "$candidate_pid" >&2
          return 1
        fi
      done
    }

    stop_all_control_centers() {
      stop_binary=$1
      if [ -x "$stop_binary" ] \
        && query_control_center "$stop_binary" \
        && [ "$queried_running" -eq 1 ] \
        && pid_is_control_center_gui "$queried_pid" "$stop_binary"; then
        if ! stop_control_center_gracefully "$stop_binary" "$queried_pid"; then
          return 1
        fi
      fi
      [ -x "$stop_binary" ] || return 0
      for process in /proc/[0-9]*; do
        candidate_pid=${process##*/}
        pid_is_control_center_gui "$candidate_pid" "$stop_binary" || continue
        printf 'codex-router: a Control Center process has no verifiable lifecycle owner (pid %s); close it normally and retry. It was not force-stopped.\n' "$candidate_pid" >&2
        return 1
      done
    }

    detect_running_companions() {
      : >"$restart_records_file"
      chmod 600 "$restart_records_file"
      lifecycle_pid=0
      lifecycle_start=0
      if [ -x "$binary_path" ] \
        && query_control_center "$binary_path" \
        && [ "$queried_running" -eq 1 ] \
        && pid_is_control_center_gui "$queried_pid" "$binary_path"; then
        record_start=$(capture_record_start canonical "$queried_pid") || {
          printf 'codex-router: the Control Center lifecycle owner changed during identity capture; it was not stopped.\n' >&2
          return 1
        }
        printf 'canonical:%s:%s:%s:1\n' "$queried_pid" "$record_start" "$queried_visible" >>"$restart_records_file"
        lifecycle_pid=$queried_pid
        lifecycle_start=$record_start
        if [ "$queried_visible" -eq 1 ]; then prior_visible=1; fi
      fi
      if [ -x "$binary_path" ]; then
        for process in /proc/[0-9]*; do
          candidate_pid=${process##*/}
          if [ "$candidate_pid" = "$lifecycle_pid" ] \
            && record_matches_bound_identity canonical "$candidate_pid" "$lifecycle_start"; then
            continue
          fi
          if launch_shape=$(control_center_launch_shape "$candidate_pid" "$binary_path"); then
            if [ "$launch_shape" = visible ]; then prior_visible=1; fi
            printf 'codex-router: a Control Center process has no verifiable lifecycle owner (pid %s); close it normally and retry. It was not force-stopped.\n' "$candidate_pid" >&2
            return 1
          fi
        done
      fi
      if [ -x "$legacy_tauri_binary" ]; then
        for process in /proc/[0-9]*; do
          candidate_pid=${process##*/}
          pid_is_legacy_tauri "$candidate_pid" || continue
          if ! record_start=$(capture_record_start tauri "$candidate_pid"); then
            pid_is_legacy_tauri "$candidate_pid" || continue
            printf 'codex-router: a legacy Tauri process identity changed during start-time capture; it was not stopped.\n' >&2
            return 1
          fi
          printf 'tauri:%s:%s:0:0\n' "$candidate_pid" "$record_start" >>"$restart_records_file"
        done
      fi
      if [ -x "$legacy_electron_binary" ]; then
        for process in /proc/[0-9]*; do
          candidate_pid=${process##*/}
          pid_is_legacy_electron "$candidate_pid" || continue
          if ! record_start=$(capture_record_start electron "$candidate_pid"); then
            pid_is_legacy_electron "$candidate_pid" || continue
            printf 'codex-router: a legacy Electron process identity changed during start-time capture; it was not stopped.\n' >&2
            return 1
          fi
          printf 'electron:%s:%s:0:0\n' "$candidate_pid" "$record_start" >>"$restart_records_file"
        done
      fi
    }

    restart_recorded_processes() {
      [ -f "$restart_records_file" ] || return 0
      restarted_kinds=' '
      while IFS=: read -r record_kind record_pid record_start record_visible record_graceful; do
        [ -n "$record_kind" ] || continue
        if record_matches_bound_identity "$record_kind" "$record_pid" "$record_start"; then continue; fi
        if record_is_running "$record_kind" "$record_pid"; then
          printf 'codex-router: a recorded companion PID now belongs to a different process start; automatic restart was refused.\n' >&2
          return 1
        fi
        case "$restarted_kinds" in *" $record_kind "*) continue ;; esac
        restarted_kinds="$restarted_kinds$record_kind "
        case "$record_kind" in
          canonical)
            if [ -x "$binary_path" ]; then
              start_control_center "$binary_path" "$record_visible" \
                || printf 'codex-router: the previous Control Center could not be restarted.\n' >&2
            fi
            ;;
          tauri)
            if [ -x "$legacy_tauri_binary" ]; then
              nohup "$legacy_tauri_binary" >/dev/null 2>&1 &
            fi
            ;;
          electron)
            if [ -x "$legacy_electron_binary" ]; then
              nohup env -u ELECTRON_RUN_AS_NODE "$legacy_electron_binary" "$legacy_electron_app" \
                >/dev/null 2>&1 &
            fi
            ;;
        esac
      done <"$restart_records_file"
    }

    write_phase() {
      journal_value=$1
      (umask 077; printf '%s\n' "$journal_value" >"$next_phase_file")
      sync_linux_entries "$next_phase_file"
      durable_linux_move "$next_phase_file" "$phase_file"
    }

    validate_transaction_tree() {
      [ -d "$transaction_dir" ] && [ ! -L "$transaction_dir" ] || return 1
      transaction_uid=$(stat -c %u "$transaction_dir" 2>/dev/null \
        || stat -f %u "$transaction_dir" 2>/dev/null || true)
      [ "$transaction_uid" = "$current_uid" ] || return 1
      for journal_entry in "$transaction_dir"/* "$transaction_dir"/.[!.]* "$transaction_dir"/..?*; do
        [ -e "$journal_entry" ] || [ -L "$journal_entry" ] || continue
        [ ! -L "$journal_entry" ] || return 1
        case ${journal_entry##*/} in
          phase|phase.next|had-previous|restart-records|staged|previous|failed) ;;
          *) return 1 ;;
        esac
      done
      for journal_directory in "$staged_dir" "$backup_dir" "$failed_dir"; do
        [ ! -e "$journal_directory" ] || [ -d "$journal_directory" ] || return 1
      done
      for journal_file in "$phase_file" "$next_phase_file" "$had_previous_file" "$restart_records_file"; do
        [ ! -e "$journal_file" ] || [ -f "$journal_file" ] || return 1
      done
      if [ -f "$restart_records_file" ]; then
        while IFS=: read -r record_kind record_pid record_start record_visible record_graceful; do
          case "$record_kind" in canonical|tauri|electron) ;; *) return 1 ;; esac
          case "$record_pid" in ''|*[!0-9]*) return 1 ;; esac
          [ "$record_pid" -gt 0 ] || return 1
          case "$record_start" in ''|*[!0-9]*) return 1 ;; esac
          [ "$record_start" -gt 0 ] || return 1
          case "$record_visible:$record_graceful" in [01]:[01]) ;; *) return 1 ;; esac
        done <"$restart_records_file"
      fi
    }

    read_transaction() {
      if [ -f "$next_phase_file" ]; then
        if [ -f "$phase_file" ]; then
          durable_linux_remove "$next_phase_file" || return 1
        else
          durable_linux_move "$next_phase_file" "$phase_file" || return 1
        fi
      fi
      [ -f "$phase_file" ] || return 2
      journal_phase=$(cat "$phase_file")
      case "$journal_phase" in
        staging|staged|draining|drained|previous-moving|previous-moved|replacement-moving|replacement-installed|replacement-starting|replacement-ready|committed) ;;
        *) return 1 ;;
      esac
      [ -f "$had_previous_file" ] || return 1
      had_previous=$(cat "$had_previous_file")
      case "$had_previous" in 0|1) ;; *) return 1 ;; esac
    }

    recover_linux_transaction() {
      [ -e "$transaction_dir" ] || return 0
      validate_linux_release_root || {
        printf 'codex-router: refusing Linux Control Center recovery through an unsafe release directory.\n' >&2
        return 1
      }
      if ! validate_transaction_tree; then
        printf 'codex-router: refusing ambiguous Linux Control Center recovery data at %s.\n' "$transaction_dir" >&2
        return 1
      fi
      read_status=0
      read_transaction || read_status=$?
      if [ "$read_status" -eq 2 ]; then
        # No durable phase means replacement of the live package never began.
        # A backup or failed directory contradicts that evidence and is refused.
        if [ -e "$backup_dir" ] || [ -e "$failed_dir" ]; then
          printf 'codex-router: refusing a Linux Control Center transaction without a phase marker.\n' >&2
          return 1
        fi
        durable_linux_remove "$transaction_dir"
        return 0
      fi
      if [ "$read_status" -ne 0 ]; then
        printf 'codex-router: refusing an unreadable Linux Control Center transaction journal.\n' >&2
        return 1
      fi
      if [ "$journal_phase" = committed ]; then
        if ! linux_package_complete "$target_dir"; then
          printf 'codex-router: the committed Linux Control Center package is incomplete or linked; recovery debris and the rollback package were preserved.\n' >&2
          return 1
        fi
        durable_linux_remove "$transaction_dir"
        return 0
      fi

      # A failed directory is written only by this recovery path. Its presence
      # makes rollback idempotent across a second crash between the two moves.
      if [ -d "$failed_dir" ] && [ -d "$target_dir" ] && [ -d "$backup_dir" ]; then
        printf 'codex-router: multiple Linux Control Center package candidates make recovery ambiguous.\n' >&2
        return 1
      fi

      if [ -d "$backup_dir" ]; then
        if [ -d "$target_dir" ]; then
          case "$journal_phase" in
            replacement-moving|replacement-installed|replacement-starting|replacement-ready)
              if ! stop_all_control_centers "$binary_path"; then
                printf 'codex-router: the uncommitted Control Center could not drain; recovery files were preserved.\n' >&2
                return 1
              fi
              [ ! -e "$failed_dir" ] || return 1
              durable_linux_move "$target_dir" "$failed_dir" || return 1
              ;;
            *)
              printf 'codex-router: both old and live Linux packages exist before replacement; recovery was refused.\n' >&2
              return 1
              ;;
          esac
        fi
        [ ! -e "$target_dir" ] || return 1
        durable_linux_move "$backup_dir" "$target_dir" || return 1
      elif [ "$had_previous" -eq 1 ]; then
        if [ -d "$failed_dir" ] && [ -d "$target_dir" ]; then
          # Recovery already restored the old package before the prior crash.
          :
        else
          case "$journal_phase" in
            staging|staged|draining|drained|previous-moving) ;;
            *)
              printf 'codex-router: the previous Linux package backup is missing; recovery was refused.\n' >&2
              return 1
              ;;
          esac
        fi
      else
        case "$journal_phase" in
          replacement-moving|replacement-installed|replacement-starting|replacement-ready)
            if [ -d "$target_dir" ]; then
              if ! stop_all_control_centers "$binary_path"; then return 1; fi
              [ ! -e "$failed_dir" ] || return 1
              durable_linux_move "$target_dir" "$failed_dir" || return 1
            fi
            ;;
        esac
      fi

      if [ -e "$staged_dir" ]; then durable_linux_remove "$staged_dir" || return 1; fi
      if [ -e "$failed_dir" ]; then durable_linux_remove "$failed_dir" || return 1; fi
      binary_path="$target_dir/codex-router-control-center"
      restart_recorded_processes
      durable_linux_remove "$transaction_dir"
      return 0
    }

    recover_pid_transactions() {
      validate_linux_release_root || return 1
      orphan_staged=
      orphan_previous=
      for orphan in "$release_dir"/.linux-unpacked.staged.*; do
        [ -e "$orphan" ] || [ -L "$orphan" ] || continue
        orphan_uid=$(stat -c %u "$orphan" 2>/dev/null \
          || stat -f %u "$orphan" 2>/dev/null || true)
        if [ -n "$orphan_staged" ] || [ -L "$orphan" ] || [ ! -d "$orphan" ] \
          || [ "$orphan_uid" != "$current_uid" ]; then
          printf 'codex-router: refusing ambiguous legacy Linux staging directories.\n' >&2
          return 1
        fi
        orphan_staged=$orphan
      done
      for orphan in "$release_dir"/.linux-unpacked.previous.*; do
        [ -e "$orphan" ] || [ -L "$orphan" ] || continue
        orphan_uid=$(stat -c %u "$orphan" 2>/dev/null \
          || stat -f %u "$orphan" 2>/dev/null || true)
        if [ -n "$orphan_previous" ] || [ -L "$orphan" ] || [ ! -d "$orphan" ] \
          || [ "$orphan_uid" != "$current_uid" ]; then
          printf 'codex-router: refusing ambiguous legacy Linux backup directories.\n' >&2
          return 1
        fi
        orphan_previous=$orphan
      done
      if [ -n "$orphan_previous" ]; then
        if [ -e "$target_dir" ]; then
          printf 'codex-router: both a live package and an unjournaled legacy backup exist; recovery was refused.\n' >&2
          return 1
        fi
        durable_linux_move "$orphan_previous" "$target_dir" || return 1
      fi
      if [ -n "$orphan_staged" ]; then durable_linux_remove "$orphan_staged" || return 1; fi
    }

    cleanup_linux() {
      cleanup_status=$?
      trap - EXIT HUP INT TERM
      if [ "$transaction_committed" -eq 0 ] && [ -e "$transaction_dir" ]; then
        recover_linux_transaction \
          || printf 'codex-router: Linux Control Center recovery remains at %s.\n' "$transaction_dir" >&2
      fi
      exit "$cleanup_status"
    }

    if ! prepare_linux_release_root; then
      printf 'codex-router: refusing an unsafe Linux Control Center release directory at %s.\n' "$release_dir" >&2
      exit 1
    fi
    if [ -L "$target_dir" ] || { [ -e "$target_dir" ] && [ ! -d "$target_dir" ]; }; then
      printf 'codex-router: refusing a non-directory Linux Control Center target at %s.\n' "$target_dir" >&2
      exit 1
    fi
    recover_pid_transactions
    recover_linux_transaction
    if [ -e "$transaction_dir" ]; then
      printf 'codex-router: refusing to overwrite a stale Linux Control Center transaction.\n' >&2
      exit 1
    fi
    mkdir -m 700 "$transaction_dir"
    had_previous=0
    if [ -d "$target_dir" ]; then had_previous=1; fi
    (umask 077; printf '%s\n' "$had_previous" >"$had_previous_file")
    sync_linux_entries "$had_previous_file" "$transaction_dir" "$release_dir"
    write_phase staging
    trap cleanup_linux EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    # Build and verify away from the live package. The builder does not move the
    # current directory or touch its successful-build stamp in this mode.
    if ! "$repo_dir/scripts/build-electron-companion.sh" --stage-only "$staged_dir" >/dev/null; then
      exit 1
    fi
    if [ ! -x "$staged_binary" ]; then
      printf 'codex-router: the staged Control Center executable is missing: %s\n' "$staged_binary" >&2
      exit 1
    fi
    write_phase staged

    # Record every exact current-user GUI identity before stopping any of them.
    # The record is rollback evidence for both a normal error and a later crash.
    detect_running_companions
    sync_linux_entries "$restart_records_file" "$transaction_dir"
    write_phase draining
    stop_recorded_processes
    write_phase drained

    open_control_center=0
    if [ "$launch_mode" = interactive ] || [ "$prior_visible" -eq 1 ]; then open_control_center=1; fi

    write_phase previous-moving
    if [ -d "$target_dir" ]; then durable_linux_move "$target_dir" "$backup_dir"; fi
    write_phase previous-moved
    write_phase replacement-moving
    if ! durable_linux_move "$staged_dir" "$target_dir"; then
      printf 'codex-router: the staged Control Center could not be installed.\n' >&2
      exit 1
    fi
    write_phase replacement-installed
    binary_path="$target_dir/codex-router-control-center"
    write_phase replacement-starting
    if ! start_control_center "$binary_path" "$open_control_center"; then
      printf 'codex-router: the packaged Control Center exited during startup: %s\n' "$binary_path" >&2
      exit 1
    fi
    new_pid=$control_center_pid

    replacement_ready=0
    wait_count=0
    while [ "$wait_count" -lt 120 ]; do
      if ! pid_is_control_center_gui "$new_pid" "$binary_path"; then break; fi
      if query_control_center "$binary_path" \
        && [ "$queried_running" -eq 1 ] \
        && [ "$queried_ready" -eq 1 ] \
        && [ "$queried_pid" -eq "$new_pid" ] \
        && pid_is_control_center_gui "$queried_pid" "$binary_path"; then
        replacement_ready=1
        break
      fi
      wait_count=$((wait_count + 1))
      sleep 1
    done
    if [ "$replacement_ready" -ne 1 ]; then
      printf 'codex-router: the replacement Control Center did not publish ready state for pid %s; restoring the previous package.\n' "$new_pid" >&2
      exit 1
    fi

    # Readiness plus the durable committed phase is the commit point. A crash
    # before it restores the previous package; a crash after it retains the
    # verified replacement and only removes recovery debris.
    write_phase replacement-ready
    if ! sync_linux_package "$target_dir"; then
      printf 'codex-router: the ready Linux Control Center package became incomplete or linked before commit; restoring the previous package.\n' >&2
      exit 1
    fi
    write_phase committed
    # The committed marker is durable before rollback deletion. Revalidate at
    # the destructive boundary so a replaced/link-swapped executable or archive
    # preserves the journal and prior package for explicit recovery.
    if ! linux_package_complete "$target_dir"; then
      printf 'codex-router: committed Linux Control Center cleanup was refused because the live package is incomplete or linked.\n' >&2
      exit 1
    fi
    transaction_committed=1
    durable_linux_remove "$transaction_dir"
    node "$repo_dir/src/install-plan.mjs" record-tray >/dev/null \
      || printf 'codex-router: could not stamp the Control Center build; the next update will rebuild it.\n' >&2
    # Only the standalone Tauri executable is an obsolete installed artifact.
    # Any surviving legacy Electron runtime is used only as exact migration
    # and process evidence; it is never launched as a second app.
    if remove_obsolete_linux_tauri; then
      if [ "$legacy_tauri_removed" -eq 1 ]; then
        printf 'Removed the superseded standalone desktop executable: %s\n' "$legacy_tauri_binary"
      fi
    else
      printf 'codex-router: the Control Center is ready, but the superseded Tauri path was unsafe or could not be removed: %s\n' "$legacy_tauri_binary" >&2
    fi
    trap - EXIT HUP INT TERM
    printf 'Control Center built and launched with its native Linux tray: %s\n' "$binary_path"
    ;;
  *)
    printf 'codex-router: on Windows run ./codex-router.ps1 tray\n' >&2
    exit 1
    ;;
esac
